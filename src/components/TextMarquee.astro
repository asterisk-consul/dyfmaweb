---
interface Props {
  texts: string[];
  direction?: 1 | -1;
  class?: string;
}

const { texts, direction, class: className = "" } = Astro.props;
---

<sy-text-marquee data-dir={direction} class:list={[className]}>
  <div class="outer">
    <div class="inner">
      {texts.map((t) => <div class="text">{t}</div>)}
    </div>
  </div>
</sy-text-marquee>

<style>
  sy-text-marquee {
    display: block;
    position: relative;
    overflow: hidden;
    width: 100vw;
    max-width: 100%;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
    background: var(--color-brand-1);
    padding: 1rem 0;

    :global(&.is-ready) {
      opacity: 1;
    }
  }

  .outer {
    display: flex;
    transform: translateX(var(--x));
    will-change: transform;
  }

  .inner {
    display: flex;
    align-items: center;
    width: fit-content;
  }

  .text {
    @extend %u-heading;
    --fs: var(--type-subtitle);
    --fw: 600;
    white-space: nowrap;
    display: flex;
    align-items: center;
    color: var(--color-white);
    -webkit-font-smoothing: antialiased;
    letter-spacing: 0.04em;

    &:before {
      display: block;
      margin: 0 0.75em;
      width: 0.25em;
      height: 0.25em;
      background: currentcolor;
      border-radius: 99px;
      content: "";
      opacity: 0.5;
    }
  }

  .text:nth-child(5n + 1) {
    --fw: 700;
    opacity: 1;
  }

  .text:nth-child(5n + 2) {
    --fw: 400;
    opacity: 0.7;
  }

  .text:nth-child(5n + 3) {
    --fw: 600;
    opacity: 0.9;
  }

  .text:nth-child(5n + 4) {
    --fw: 500;
    opacity: 0.6;
  }

  .text:nth-child(5n + 5) {
    --fw: 700;
    opacity: 1;
  }
</style>

<script>
  import { addResizeObserver } from "../utils/helpers";
  import { gsap } from "gsap";

  class TextMarquee extends HTMLElement {
    x = 0;
    textWidth = -1;
    direction = 1;
    html: string;
    outerEl: HTMLElement;
    private isVisible = false;

    constructor() {
      super();
      this.direction = Number(this.dataset.dir) || 1;
      this.outerEl = this.querySelector(".outer") as HTMLElement;
      this.html = this.outerEl.innerHTML;
      this.x = Math.round(1000 * -this.direction * Math.random());
      addResizeObserver(this);
    }

    connectedCallback() {
      const observer = new IntersectionObserver(
        ([entry]) => {
          this.isVisible = entry.isIntersecting;
          if (entry.isIntersecting) observer.disconnect();
        },
        { threshold: 0 },
      );
      observer.observe(this);

      gsap.ticker.add(this.tick);

      Promise.race([
        document.fonts.ready,
        new Promise<void>((r) => setTimeout(r, 2000)),
      ]).then(() => {
        this.fill();
        this.classList.add("is-ready");
      });
    }

    disconnectedCallback() {
      gsap.ticker.remove(this.tick);
    }

    onWidthResize() {
      this.fill();
    }

    fill() {
      const { html, outerEl } = this;

      outerEl.innerHTML = html;

      const bcr = outerEl.firstElementChild!.getBoundingClientRect();
      const width = window.innerWidth;

      if (!bcr.width) {
        return;
      }

      const repeats = Math.ceil(width / bcr.width) * 2;

      outerEl.innerHTML += html.repeat(repeats - 1);

      [...outerEl.children].forEach((el, i) => {
        if (i > 0) {
          el.ariaHidden = "true";
        }
      });

      this.textWidth = Math.round(outerEl.scrollWidth / 2);
    }

    tick = () => {
      if (!this.isVisible) return;
      const txtWidth = this.textWidth;
      let x = this.x;

      const dir = this.direction;
      x -=
        (Math.min(Math.abs(window.scrollVelocity) * 0.4, 10) + 0.5) *
        (window.scrollDirection || 1) *
        dir;

      if (x <= -txtWidth) {
        x = 0;
      } else if (x > 0) {
        x = -txtWidth;
      }

      this.style.setProperty("--x", `${x}px`);
      this.x = x;
    }
  }

  customElements.define("sy-text-marquee", TextMarquee);
</script>
