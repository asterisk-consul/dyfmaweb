---
import type { Link } from "../types";

interface Props {
  links: Link[];
}

const { links } = Astro.props;
---

<sy-footer>
  <footer>
    <div class="inner u-container">
      <div class="wrapper">
        <a class="logo" href="https://asteriskconsultora.com/" target="_blank" rel="noopener">
          <img src="/dyfmaweb/LogoAsterisk.svg" alt="Asterisk Consultora" />
        </a>

        <div class="menu">
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={l.url}>{l.title}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="contact-info">
          <a href="https://wa.me/5493534118602" target="_blank" rel="noopener" class="contact-item contact-link">+549 3534 11-8602</a>
          <a href="mailto:info@dyfma.ar" class="contact-item contact-link">info@dyfma.ar</a>
        </div>

        <p class="cp"><a class="logo-inline" href="https://asteriskconsultora.com/" target="_blank" rel="noopener"><img src="/dyfmaweb/LogoAsterisk.svg" alt="" />Asterisk Consultora</a> &copy; {new Date().getFullYear()}</p>
      </div>
    </div>
  </footer>
</sy-footer>

<style>
  sy-footer {
    @extend %u-text;

    --fs: var(--font-size-xs);
    display: block;
    background: var(--color-brand-5);
    color: rgba(255, 255, 255, 0.6);
    position: relative;
    z-index: 10;
  }

  footer {
    width: 100%;
  }

  .inner {
    padding: 1rem 0;
  }

  .cp {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.4);
    font-size: var(--font-size-xs);
  }

  .contact-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;

    @media (--mq-tablet) {
      justify-content: center;
    }
  }

  .contact-item {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }

  .contact-link {
    text-decoration: none;
    transition: color 0.2s ease;

    &:hover,
    &:focus {
      color: var(--color-brand-1);
    }
  }

  .logo-inline {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.5);
    transition: color 0.2s ease;

    &:hover {
      color: rgba(255, 255, 255, 0.8);
    }

    img {
      height: 1rem;
      width: auto;
      filter: brightness(0) invert(1);
    }
  }


  .logo {
    position: relative;
    z-index: 3;

    img {
      height: 1.4rem;
      width: auto;
      filter: brightness(0) invert(1);
    }
  }

  .menu {
    ul {
      display: flex;
      padding: 0;
      gap: 1.25rem;
      margin: 0;
      list-style: none;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;

      a {
        text-decoration: none;
        position: relative;
        color: rgba(255, 255, 255, 0.6);
        font-family: var(--font-heading);
        font-size: var(--font-size-xs);
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        transition: color 0.2s ease;

        &:hover {
          color: var(--color-brand-1);
        }
      }
    }
  }

  .wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;

    @media (--mq-tablet) {
      flex-direction: column;
    }
  }
</style>

<script>
  class Footer extends HTMLElement {}
  customElements.define("sy-footer", Footer);
</script>
