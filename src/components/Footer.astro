---
import type { Link } from "../types";

interface Props {
  links: Link[];
}

const { links } = Astro.props;
const year = new Date().getFullYear();
---

<sy-footer>
  <footer>
    <div class="inner u-container">
      <div class="top">
        <!-- Brand -->
        <div class="brand">
          <a class="logo" href="/dyfmaweb/" aria-label="DYFMA — inicio">
            <img src="/dyfmaweb/logo.svg" alt="DYFMA" />
          </a>

          <p class="claim">
            Ingeniería argentina
            <br />
            para el <span class="claim-accent">fruto seco.</span>
          </p>

          <p class="brand-desc">
            DYFMA · +12 años fabricando soluciones para la cosecha,
            procesamiento y agregado de valor de frutos secos. Más de 200
            equipos instalados en Argentina y la región.
          </p>
        </div>

        <!-- Contacto -->
        <div class="col">
          <span class="col-title u-spec">Contacto</span>
          <a href="https://wa.me/5493534118602" target="_blank" rel="noopener" class="contact-link">+54 9 3534 11-8602</a>
          <a href="mailto:info@dyfma.ar" class="contact-link">info@dyfma.ar</a>
          <a
            href="https://www.instagram.com/dyfma?igsi=MXZhc2k2ZmMwb29tdw=="
            target="_blank"
            rel="noopener"
            class="contact-link contact-instagram"
          >
            <svg class="ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            <span>@dyfma</span>
          </a>
          <span class="contact-muted">Ruta Nac. N° 9 — Parque Industrial — Villa María, Córdoba</span>
        </div>

        <!-- Conectar -->
        <div class="col">
          <span class="col-title u-spec">Conectar</span>
          <div class="connect-actions">
            <a
              href="https://wa.me/5493534118602"
              target="_blank"
              rel="noopener"
              class="connect-btn"
            >
              <svg class="connect-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              <span>WhatsApp</span>
            </a>

            <a href="mailto:info@dyfma.ar" class="connect-btn">
              <svg class="connect-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 7-10 6L2 7"/>
              </svg>
              <span>Email</span>
            </a>
          </div>
        </div>
      </div>

      <div class="bottom">
        <p class="cp">
          &copy; {year} DYFMA · Industrialización del fruto seco. Desarrollado por
          <a class="logo-inline" href="https://asteriskconsultora.com/" target="_blank" rel="noopener">
            <img src="/dyfmaweb/LogoAsterisk.svg" alt="" />Asterisk
          </a>
        </p>

        <nav class="menu" aria-label="Menú del pie de página">
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={l.url}>{l.title}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </footer>
</sy-footer>

<style>
  sy-footer {
    @extend %u-text;

    --fs: var(--font-size-xs);
    display: block;
    background: var(--color-brand-5);
    color: rgba(255, 255, 255, 0.6);
    position: relative;
    z-index: 10;
  }

  footer {
    width: 100%;
  }

  .inner {
    padding: 4rem 0 1.5rem;
  }

  /* =========================================================
     TOP
     ========================================================= */

  .top {
    display: grid;

    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);

    gap: 3rem;

    align-items: start;

    padding-bottom: 3.5rem;
  }

  .logo {
    display: inline-block;

    img {
      height: 2.25rem;
      width: auto;
      filter: brightness(0) invert(1);
    }
  }

  .claim {
    margin: 1.75rem 0 0;

    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 500;
    line-height: 1.02;

    letter-spacing: -0.01em;

    color: var(--color-white);
  }

  .claim-accent {
    color: var(--color-brand-1);
  }

  .brand-desc {
    margin: 1.5rem 0 0;

    max-width: 26em;

    font-size: var(--font-size-sm);
    line-height: 1.65;

    color: rgba(255, 255, 255, 0.55);
  }

  /* Columns */
  .col {
    display: flex;
    flex-direction: column;

    align-items: flex-start;

    gap: 0.9rem;

    padding-top: 0.5rem;
  }

  .col-title {
    font-size: 0.65rem;

    letter-spacing: 0.14em;

    color: rgba(255, 255, 255, 0.45);

    margin-bottom: 0.4rem;
  }

  .contact-link {
    font-family: var(--font-body);
    font-size: var(--font-size-md);

    color: var(--color-white);

    text-decoration: none;

    transition: color 0.2s ease;

    &:hover,
    &:focus {
      color: var(--color-brand-1);
    }
  }

  .contact-muted {
    font-size: var(--font-size-sm);
    line-height: 1.6;

    color: rgba(255, 255, 255, 0.45);

    max-width: 22em;
  }

  .contact-instagram {
    display: inline-flex;

    align-items: center;

    gap: 0.5rem;
  }

  .ig-icon {
    width: 1rem;
    height: 1rem;

    flex-shrink: 0;
  }

  .connect-actions {
    display: flex;

    gap: 0.75rem;

    flex-wrap: wrap;
  }

  .connect-btn {
    display: inline-flex;

    align-items: center;

    gap: 0.6rem;

    padding: 0.8rem 1.4rem;

    border: 1px solid rgba(255, 255, 255, 0.15);

    color: var(--color-white);

    text-decoration: none;

    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: 500;

    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;

    &:hover,
    &:focus {
      border-color: var(--color-brand-1);
      color: var(--color-brand-1);
    }
  }

  .connect-icon {
    width: 1.1em;
    height: 1.1em;

    flex-shrink: 0;
  }

  /* =========================================================
     BOTTOM
     ========================================================= */

  .bottom {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 1.5rem;

    padding-top: 1.5rem;

    border-top: 1px solid rgba(255, 255, 255, 0.08);

    @media (--mq-tablet) {
      flex-direction: column;
    }
  }

  .cp {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.4);
    font-size: var(--font-size-xs);
  }

  .logo-inline {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.2s ease;

    &:hover {
      color: rgba(255, 255, 255, 0.85);
    }

    img {
      height: 0.9rem;
      width: auto;
      filter: brightness(0) invert(1);
    }
  }

  .menu {
    ul {
      display: flex;
      padding: 0;
      gap: 1.25rem;
      margin: 0;
      list-style: none;
      flex-wrap: wrap;
      align-items: center;

      a {
        text-decoration: none;
        position: relative;
        color: rgba(255, 255, 255, 0.55);
        font-family: var(--font-body);
        font-size: var(--font-size-xs);
        font-weight: 500;
        transition: color 0.2s ease;

        &:hover {
          color: var(--color-brand-1);
        }
      }
    }
  }

  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (--mq-tablet) {
    .top {
      grid-template-columns: 1fr;

      gap: 2.5rem;

      padding-bottom: 2.5rem;
    }

    .inner {
      padding-top: 3rem;
    }
  }
</style>

<script>
  class Footer extends HTMLElement {}
  customElements.define("sy-footer", Footer);
</script>
