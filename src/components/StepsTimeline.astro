---
interface Props {
  title: string;
  items: {
    title: string;
    text: string;
    image?: string;
    video?: string;
  }[];
  class?: string;
}

const { title, items, class: className } = Astro.props;
---

<sy-steps-timeline class:list={[className]}>
  <div class="u-container container">
    <div class="wrapper">

      <!-- Header -->
      <div class="content">
        <div class="u-eyebrow" data-sy-reveal="fade">
          <span class="u-eyebrow-line"></span>
          <span>PROCESO</span>
        </div>

        <h2 class="section-title" data-sy-reveal="words">
          {title}
        </h2>
      </div>

      <!-- Process -->
      <div class="layout">

        <!-- Steps -->
        <div class="items-wrapper">
          <div class="timeline-line"></div>

          <div class="items">
            {
              items.map((item, i) => (
                <div
                  class:list={["item", i === 0 && "is-active"]}
                  data-step={i}
                >
                  <div class="item-marker">
                    <span>{String(i + 1).padStart(2, "0")}</span>
                  </div>

                  <div class="item-inner">
                    <h3 class="item-title">
                      {item.title}
                    </h3>

                    <p class="item-text u-text">
                      {item.text}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Image -->
        <div class="step-frame">

          <div class="step-frame-label">
            <span>DYFMA</span>
            <span class="step-counter">
              01 / {String(items.length).padStart(2, "0")}
            </span>
          </div>

          <div class="step-images">
            {
              items.map((item, i) => (
                <div
                  class:list={["step-image", i === 0 && "is-active"]}
                >
                  {item.video ? (
                    <video
                      src={item.video}
                      autoplay
                      loop
                      muted
                      playsinline
                    ></video>
                  ) : item.image ? (
                    <img
                      src={item.image}
                      alt={item.title}
                      width="800"
                      height="600"
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  ) : null}

                  <div class="image-overlay"></div>
                </div>
              ))
            }
          </div>

          <div class="step-accent"></div>
        </div>

      </div>
    </div>
  </div>
</sy-steps-timeline>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  class StepsTimeline extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = "true";

      const itemsWrapper = this.querySelector(".items-wrapper");
      const wrapper = this.querySelector(".wrapper");
      const items = Array.from(
        this.querySelectorAll<HTMLElement>(".item"),
      );
      const images = Array.from(
        this.querySelectorAll<HTMLElement>(".step-image"),
      );
      const counter = this.querySelector(".step-counter");

      if (!itemsWrapper || !wrapper || !items.length) return;

      let current = 0;

      const setActive = (index: number) => {
        if (index === current) return;

        items[current]?.classList.remove("is-active");
        images[current]?.classList.remove("is-active");

        items[index]?.classList.add("is-active");
        images[index]?.classList.add("is-active");

        if (counter) {
          counter.textContent =
            `${String(index + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}`;
        }

        current = index;
      };

      ScrollTrigger.create({
        trigger: itemsWrapper,
        pin: wrapper,
        start: "top top",
        end: () => `+=${window.innerHeight * items.length * 0.85}`,
        anticipatePin: 1,
        invalidateOnRefresh: true,

        onUpdate: (self) => {
          const index = Math.min(
            Math.floor(self.progress * items.length),
            items.length - 1,
          );

          setActive(index);
        },
      });

      const refresh = () => ScrollTrigger.refresh();

      window.addEventListener("load", refresh);
    }
  }

  customElements.define("sy-steps-timeline", StepsTimeline);
</script>

<style>
/* =========================================================
   SECTION
   ========================================================= */

sy-steps-timeline {
  display: block;

  position: relative;

  margin: clamp(6rem, 10vw, 10rem) 0;

  overflow: hidden;
}
.container {
  position: relative;

  z-index: 2;
}

.wrapper {
  width: 100%;
}


/* =========================================================
   HEADER
   ========================================================= */

.content {
  position: relative;

  margin-bottom: clamp(2.5rem, 4vw, 4rem);
}

.section-title {
  --fs: var(--type-display);
  --lh: 0.98;
  --fw: 500;

  margin: 0;

  max-width: 11em;

  font-family: var(--font-heading);

  font-size: var(--fs);
  font-weight: var(--fw);
  line-height: var(--lh);

  letter-spacing: -0.01em;

  color: var(--color-brand-1);
}


/* =========================================================
   LAYOUT
   ========================================================= */

.layout {
  display: grid;

  grid-template-columns:
    minmax(0, 0.85fr)
    minmax(0, 1.15fr);

  gap: clamp(3rem, 6vw, 7rem);

  align-items: stretch;
}


/* =========================================================
   TIMELINE
   ========================================================= */

.items-wrapper {
  position: relative;

  min-height: 32rem;

  padding-left: 4rem;
}

.timeline-line {
  position: absolute;

  top: 0;
  bottom: 0;
  left: 1rem;

  width: 1px;

  background: rgba(255, 255, 255, 0.1);
}


/* =========================================================
   ITEMS
   ========================================================= */

.items {
  display: flex;
  flex-direction: column;

  width: 100%;
  max-width: 30rem;
}

.item {
  position: relative;

  display: grid;

  grid-template-columns: 2.5rem 1fr;

  gap: 1.5rem;

  min-height: 9rem;

  opacity: 0.38;

  transition:
    opacity 400ms ease,
    transform 400ms ease;
}

.item.is-active {
  opacity: 1;

  transform: translateX(0.35rem);
}


/* =========================================================
   MARKER
   ========================================================= */

.item-marker {
  position: relative;

  width: 2rem;
  height: 2rem;

  display: grid;
  place-items: center;

  margin-top: 0.1rem;

  border: 1px solid rgba(255, 255, 255, 0.14);

  background: var(--color-bg);

  transition:
    border-color 300ms ease,
    background 300ms ease,
    color 300ms ease,
    transform 300ms ease;

  z-index: 2;
}

.item-marker span {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  font-weight: 500;

  color: var(--color-text-alt);
}

.item.is-active .item-marker {
  border-color: var(--color-brand-1);

  background: var(--color-brand-1);

  transform: scale(1.08);
}

.item.is-active .item-marker span {
  color: #fff;
}


/* =========================================================
   ITEM CONTENT
   ========================================================= */

.item-inner {
  display: flex;
  flex-direction: column;

  gap: 0.65rem;

  padding-bottom: 2rem;
}

.item-title {
  --fs: var(--type-title);
  --fw: 500;

  margin: 0;

  font-family: var(--font-heading);

  font-size: var(--fs);
  font-weight: var(--fw);

  line-height: 1.1;

  letter-spacing: -0.01em;

  color: var(--color-brand-1);

  transition:
    color 300ms ease,
    transform 300ms ease;
}

.item.is-active .item-title {
  color: var(--color-brand-1);
}

.item-text {
  --fs: var(--font-size-md);

  margin: 0;

  max-width: 28em;

  font-size: var(--fs);
  line-height: 1.55;

  color: var(--color-text-alt);
}


/* =========================================================
   IMAGE FRAME
   ========================================================= */

.step-frame {
  position: relative;

  width: 100%;

  display: flex;
  flex-direction: column;

  padding: clamp(1rem, 2vw, 1.75rem);

  isolation: isolate;
}


/* Main frame */
.step-frame::before {
  content: "";

  position: absolute;

  inset: 0;

  border: 1px solid rgba(242, 140, 40, 0.22);

  transform: translate(-1rem, 1rem);

  z-index: -1;
}


/* Secondary frame */
.step-frame::after {
  content: "";

  position: absolute;

  top: 1.75rem;
  right: 0;
  bottom: 0;
  left: 1.75rem;

  border: 1px solid rgba(255, 255, 255, 0.08);

  z-index: -2;
}


/* =========================================================
   IMAGE HEADER
   ========================================================= */

.step-frame-label {
  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  transform: translateY(-100%);

  display: flex;
  justify-content: space-between;
  align-items: center;

  padding-bottom: 0.75rem;

  font-family: var(--font-mono);
  font-size: 0.6rem;
  font-weight: 500;

  letter-spacing: 0.1em;
  text-transform: uppercase;

  color: var(--color-text-alt);
}

.step-frame-label > span:first-child {
  color: var(--color-brand-1);
}


/* =========================================================
   IMAGE CONTAINER
   ========================================================= */

.step-images {
  position: relative;

  flex: 1;

  min-height: 0;

  width: min(100%, 22rem);

  margin: 0 auto;

  overflow: hidden;

  background: #f5f5f5;
}


/* =========================================================
   INDIVIDUAL IMAGES
   ========================================================= */

.step-image {
  position: absolute;

  inset: 0;

  overflow: hidden;

  opacity: 0;

  transition:
    opacity 500ms ease,
    transform 700ms ease;

  transform: scale(1.025);

  pointer-events: none;
}

.step-image.is-active {
  opacity: 1;

  transform: scale(1);

  pointer-events: auto;
}

.step-image img,
.step-image video {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
}


/* =========================================================
   IMAGE OVERLAY
   ========================================================= */

.image-overlay {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.04),
      transparent 45%
    );

  pointer-events: none;
}


/* =========================================================
   ORANGE CORNER
   ========================================================= */

.step-accent {
  position: absolute;

  right: 0;
  bottom: 0;

  width: 4.5rem;
  height: 4.5rem;

  border-right: 3px solid var(--color-brand-1);
  border-bottom: 3px solid var(--color-brand-1);

  z-index: 3;
}


/* =========================================================
   LAPTOP (988px – 1536px)
   ========================================================= */

@media (--mq-desktop-md) {

  sy-steps-timeline {
    margin: 4rem 0;
  }

  .layout {
    gap: 3rem;
  }

  .items-wrapper {
    min-height: 0;

    padding-left: 3rem;
  }

  .content {
    margin-bottom: 2rem;
  }

  .items {
    max-width: 26rem;
  }

  .item {
    min-height: 0;
  }

  .item-inner {
    padding-bottom: 1.5rem;
  }

  .step-frame::before,
  .step-frame::after {
    transform: none;

    inset: 0 0 0 1.25rem;
  }
}


/* =========================================================
   TABLET
   ========================================================= */

@media (--mq-tablet) {

  sy-steps-timeline {
    margin: 5rem 0;
  }

  .content {
    margin-bottom: 3rem;
  }

  .section-title {
    --fs: var(--type-display-md);
  }

  .layout {
    grid-template-columns: 1fr;

    gap: 4rem;
  }

  .step-images {
    flex: none;

    width: 100%;

    aspect-ratio: 9 / 16;
  }

  .items-wrapper {
    min-height: auto;

    padding-left: 2.5rem;
  }

  .timeline-line {
    left: 0.5rem;
  }

  .items {
    max-width: 100%;
  }

  .item {
    grid-template-columns: 2rem 1fr;

    gap: 1.25rem;

    min-height: auto;
  }

  .item-inner {
    padding-bottom: 2rem;
  }

  .item.is-active {
    transform: none;
  }

  .step-frame {
    padding: 1rem;
  }

  .step-frame::before,
  .step-frame::after {
    display: none;
  }

  .step-images {
    aspect-ratio: 9 / 16;
  }
}


/* =========================================================
   PHONE
   ========================================================= */

@media (--mq-phone) {

  sy-steps-timeline {
    margin: 4rem 0;
  }

  .content {
    margin-bottom: 2.5rem;
  }

  .section-title {
    --fs: var(--type-title);

    line-height: 1.02;
  }

  .layout {
    gap: 3rem;
  }

  .items-wrapper {
    padding-left: 2rem;
  }

  .timeline-line {
    left: 0.45rem;
  }

  .item {
    grid-template-columns: 1.75rem 1fr;

    gap: 1rem;
  }

  .item-marker {
    width: 1.75rem;
    height: 1.75rem;
  }

  .item-marker span {
    font-size: 0.52rem;
  }

  .item-inner {
    gap: 0.5rem;

    padding-bottom: 1.75rem;
  }

  .item-title {
    --fs: var(--font-size-lg);
  }

  .item-text {
    --fs: var(--font-size-md);

    line-height: 1.5;
  }

  .step-frame {
    padding: 0.5rem;
  }

  .step-frame-label {
    font-size: 0.55rem;
  }

  .step-images {
    aspect-ratio: 9 / 16;
  }

  .step-accent {
    width: 3rem;
    height: 3rem;

    border-width: 2px;
  }
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .item,
  .item-marker,
  .item-title,
  .step-image {
    transition: none;
  }
}

