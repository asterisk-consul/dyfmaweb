<script>
  const tooltip = document.getElementById("map-tooltip")!;
  const tooltipName = tooltip.querySelector(".tooltip-name")!;
  const tooltipFruits = tooltip.querySelector(".tooltip-fruits")!;
  const tooltipDesc = tooltip.querySelector(".tooltip-desc")!;
  const countries = document.querySelectorAll(".country");

  const marketData = {
    brasil: { name: "Brasil", fruits: "Nuez Pecán · Almendra", desc: "Equipos DYFMA instalados." },
    chile: { name: "Chile", fruits: "Nuez Chandler · Almendra · Avellana", desc: "Equipos DYFMA instalados." },
    argentina: { name: "Argentina", fruits: "Nuez Chandler · Pecán · Almendra", desc: "Mercado principal — +200 equipos instalados en 18 provincias." },
    paraguay: { name: "Paraguay", fruits: "Nuez Pecán · Almendra", desc: "Equipos DYFMA instalados." },
    uruguay: { name: "Uruguay", fruits: "Nuez Chandler · Pecán", desc: "Equipos DYFMA instalados." },
  };

  function showTooltip(e: MouseEvent, data: any) {
    tooltipName.textContent = data.name;
    tooltipFruits.textContent = data.fruits;
    tooltipDesc.textContent = data.desc;
    tooltip.classList.add("visible");

    const rect = (e.target as HTMLElement).getBoundingClientRect();
    const wrapper = document.querySelector(".map-wrapper")!.getBoundingClientRect();

    let x = rect.left - wrapper.left + rect.width / 2;
    let y = rect.top - wrapper.top - 10;

    if (x > wrapper.width - 160) x = wrapper.width - 170;
    if (x < 10) x = 10;
    if (y < 60) y = rect.top - wrapper.top + rect.height + 10;

    tooltip.style.left = `${x}px`;
    tooltip.style.top = `${y}px`;
  }

  function hideTooltip() {
    tooltip.classList.remove("visible");
  }

  countries.forEach((c) => {
    const id = c.getAttribute("data-country")!;
    const data = marketData[id as keyof typeof marketData];
    if (!data) return;

    c.addEventListener("mouseenter", (e) => showTooltip(e, data));
    c.addEventListener("mousemove", (e) => showTooltip(e, data));
    c.addEventListener("mouseleave", hideTooltip);
  });
</script>

