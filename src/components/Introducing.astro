---
import Button from "../components/Button.astro";
import type { Link } from "../types";

interface Props {
  title: string;
  text: string;
  textExtra?: string;
  cta?: Link;
  image?: { src: string; alt: string };
  class?: string;
}

const { title, text, textExtra, cta, image, class: className } = Astro.props;
---

<section class:list={["introducing", className]}>
  <div class="u-container container">
    <div class="inner">

      <!-- =====================================================
           TEXT
           ===================================================== -->

      <div class="text-col">

        <div class="u-eyebrow" data-sy-reveal="fade">
          <span class="u-eyebrow-line"></span>
          <span>INGENIERÍA ARGENTINA</span>
        </div>

        <h2 class="intro-title" data-sy-reveal="words">
          {title}
        </h2>

        <p class="intro-text u-text" data-sy-reveal="lines">
          {text}
        </p>

        {textExtra ? (
          <p class="intro-text" data-sy-reveal="lines">
            {textExtra}
          </p>
        ) : null}

        {cta ? (
          <div class="cta-wrapper">
            <Button {...cta} arrow class="cta" />
          </div>
        ) : null}

        <!-- Technical detail -->
        <div class="intro-meta" data-sy-reveal="fade">
          <span>FABRICACIÓN NACIONAL</span>
          <span class="meta-dot"></span>
          <span>DESDE 2012</span>
        </div>

      </div>


      <!-- =====================================================
           MEDIA
           ===================================================== -->

      <div class="media" data-sy-reveal="fade">

        <div class="media-frame">

          <div class="media-label">
            <span>DYFMA</span>
            <span>ARG / LATAM</span>
          </div>

          <div class="media-content">

            {image ? (
              <img
                src={image.src}
                alt={image.alt}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <slot name="media" />
            )}

          </div>

          <div class="media-accent"></div>

        </div>

      </div>

    </div>
  </div>
</section>

<style>
/* =========================================================
   SECTION
   ========================================================= */

.introducing {
  position: relative;

  width: 100%;

  padding: clamp(7rem, 12vw, 11rem) 0;

  overflow: hidden;
}


/* =========================================================
   CONTAINER
   ========================================================= */

.container {
  position: relative;

  z-index: 2;
}


/* =========================================================
   LAYOUT
   ========================================================= */

.inner {
  display: grid;

  grid-template-columns:
    minmax(0, 0.9fr)
    minmax(0, 1.1fr);

  align-items: center;

  gap: clamp(3rem, 7vw, 8rem);

  width: min(100%, 78rem);

  margin: 0 auto;
}


/* =========================================================
   TEXT
   ========================================================= */

.text-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;

  min-width: 0;
}


/* =========================================================
   TITLE
   ========================================================= */

.intro-title {
  --fs: var(--type-display);
  --lh: 0.98;
  --fw: 500;

  margin: 1.5rem 0 0;

  max-width: 11em;

  font-family: var(--font-heading);

  font-size: var(--fs);
  font-weight: var(--fw);
  line-height: var(--lh);

  letter-spacing: -0.01em;

  color: var(--color-brand-1);
}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.intro-text {
  max-width: 34em;

  margin: 1.75rem 0 0;

  font-family: var(--font-body);

  font-size: var(--font-size-lg);
  line-height: 1.55;

  color: var(--color-text-alt);
}

.intro-text + .intro-text {
  margin-top: 1rem;
}


/* =========================================================
   CTA
   ========================================================= */

.cta-wrapper {
  margin-top: 2rem;
}


/* =========================================================
   META
   ========================================================= */

.intro-meta {
  display: flex;
  align-items: center;

  gap: 0.7rem;

  margin-top: 3rem;

  font-family: var(--font-mono);
  font-size: 0.58rem;
  font-weight: 500;

  letter-spacing: 0.1em;
  text-transform: uppercase;

  color: var(--color-text-alt);

  opacity: 0.65;
}

.meta-dot {
  width: 4px;
  height: 4px;

  border-radius: 50%;

  background: var(--color-brand-1);
}


/* =========================================================
   MEDIA
   ========================================================= */

.media {
  position: relative;

  width: 100%;
  min-width: 0;
}


/* =========================================================
   MEDIA FRAME
   ========================================================= */

.media-frame {
  position: relative;

  width: 100%;

  padding: clamp(1rem, 2vw, 2rem);

  isolation: isolate;
}


/* Orange frame */
.media-frame::before {
  content: "";

  position: absolute;

  inset: 0;

  border: 1px solid rgba(242, 140, 40, 0.22);

  transform: translate(-1rem, 1rem);

  z-index: -1;
}


/* Secondary architectural frame */
.media-frame::after {
  content: "";

  position: absolute;

  top: 1.75rem;
  right: 0;
  bottom: 0;
  left: 1.75rem;

  border: 1px solid rgba(255, 255, 255, 0.08);

  z-index: -2;
}


/* =========================================================
   MEDIA LABEL
   ========================================================= */

.media-label {
  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  display: flex;
  justify-content: space-between;
  align-items: center;

  transform: translateY(-100%);

  padding-bottom: 0.75rem;

  font-family: var(--font-mono);
  font-size: 0.58rem;
  font-weight: 500;

  letter-spacing: 0.1em;
  text-transform: uppercase;

  color: var(--color-text-alt);
}

.media-label span:first-child {
  color: var(--color-brand-1);
}


/* =========================================================
   MEDIA CONTENT
   ========================================================= */

.media-content {
  position: relative;

  width: 100%;

  min-height: 32rem;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.025),
      transparent 60%
    );
}


/* =========================================================
   IMAGE
   ========================================================= */

.media :global(img) {
  display: block;

  width: 100%;
  height: auto;

  max-height: 34rem;

  object-fit: contain;

  filter:
    drop-shadow(0 20px 40px rgba(0, 0, 0, 0.07));
}


/* =========================================================
   SLOT
   ========================================================= */

.media :global(svg) {
  display: block;

  width: 100%;
  height: auto;

  max-width: 100%;
  max-height: 34rem;
}


/* =========================================================
   VIDEO (slot) — fills the whole media frame
   ========================================================= */

.media :global(video) {
  position: absolute;

  inset: 0;

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  z-index: 1;
}


/* =========================================================
   ORANGE ACCENT
   ========================================================= */

.media-accent {
  position: absolute;

  right: 0;
  bottom: 0;

  width: 5rem;
  height: 5rem;

  border-right: 3px solid var(--color-brand-1);
  border-bottom: 3px solid var(--color-brand-1);

  z-index: 4;

  pointer-events: none;
}


/* =========================================================
   LAPTOP (988px – 1536px)
   ========================================================= */

@media (--mq-desktop-md) {

  .introducing {
    padding: clamp(5rem, 8vw, 8rem) 0;
  }

  .inner {
    gap: 3.5rem;
  }

  .media-content {
    min-height: 26rem;
  }
}


/* =========================================================
   TABLET
   ========================================================= */

@media (--mq-tablet) {

  .introducing {
    padding: 6rem 0;
  }

  .inner {
    grid-template-columns: 1fr;

    gap: 4rem;

    width: 100%;
  }

  .text-col {
    align-items: center;

    text-align: center;
  }

  .intro-title {
    --fs: var(--type-display-md);

    max-width: 13em;
  }

  .intro-text {
    max-width: 40em;
  }

  .intro-meta {
    justify-content: center;
  }

  .media {
    width: min(100%, 42rem);

    margin: 0 auto;
  }

  .media-frame::before,
  .media-frame::after {
    display: none;
  }

  .media-content {
    min-height: 28rem;
  }
}


/* =========================================================
   PHONE
   ========================================================= */

@media (--mq-phone) {

  .introducing {
    padding: 5rem 0;
  }

  .inner {
    gap: 3rem;
  }

  .intro-title {
    --fs: var(--type-title);

    line-height: 1.02;
  }

  .intro-text {
    font-size: var(--font-size-md);

    margin-top: 1.25rem;
  }

  .cta-wrapper {
    margin-top: 1.75rem;
  }

  .intro-meta {
    flex-wrap: wrap;

    justify-content: center;

    margin-top: 2.5rem;

    font-size: 0.52rem;
  }

  .media-frame {
    padding: 0.5rem;
  }

  .media-content {
    min-height: 18rem;
  }

  .media-label {
    font-size: 0.5rem;
  }

  .media-accent {
    width: 3rem;
    height: 3rem;

    border-width: 2px;
  }
}


/* =========================================================
   VIDEO SLOT — el video es vertical (9:16): marco retrato
   para que se vea completo, sin recorte
   ========================================================= */

.media:has(video) .media-frame {
  width: fit-content;
  margin: 0 auto;
}

.media-content:has(video) {
  min-height: 0;
  width: auto;
  height: 36rem;
  aspect-ratio: 9 / 16;
}

@media (--mq-desktop-md) {
  .media-content:has(video) {
    height: 32rem;
  }
}

@media (--mq-tablet) {
  .media-content:has(video) {
    height: 34rem;
  }
}

@media (--mq-phone) {
  .media-content:has(video) {
    height: 26rem;
  }
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .media :global(img),
  .media :global(svg) {
    transition: none;
  }
}
</style>
