---
import Button from "./Button.astro";
import TextMarquee from "../components/TextMarquee.astro";
import { machines } from "../data/machines";
import type { MachineCategory, Machine } from "../data/machines";

interface Props {
  title: string;
  text?: string;
  cta?: { title: string; url: string };
  marqueeTexts: string[];
  class?: string;
}

const { title, text, cta, marqueeTexts, class: className } = Astro.props;

const steps: { label: string; num: string; cat: MachineCategory }[] = [
  { label: "Cosecha", num: "01", cat: "cosecha" },
  { label: "Poscosecha", num: "02", cat: "poscosecha" },
  { label: "Pelado | Partido", num: "03", cat: "pelado-partido" },
  { label: "Post Pelado", num: "04", cat: "post-pelado" },
];

const grouped = machines.reduce((acc, m) => {
  if (!acc[m.category]) acc[m.category] = [];
  acc[m.category].push(m);
  return acc;
}, {} as Record<MachineCategory, Machine[]>);

const cardSpecs = (m: Machine) => {
  const key = m.specs.find(s => /rendimiento|capacidad/i.test(s.label)) ?? m.specs[0];
  const rest = m.specs.filter(s => s !== key);
  return [key, rest[0], rest[1]].filter(Boolean) as Machine["specs"];
};
---

<div id="productos" class:list={["gallery-text", className]}>
  <div class="u-container container">

    <div class="content">
      <div class="u-eyebrow" data-sy-reveal="fade">
        <span class="u-eyebrow-line"></span>
        <span>MAQUINARIA</span>
      </div>
      <h2 class="section-title" data-sy-reveal="words">{title}</h2>
      <p class="section-body" data-sy-reveal="lines">{text}</p>
      {cta ? <Button {...cta} arrow class="cta" revealable={false} /> : null}
    </div>

    <div class="tabs-wrap" data-sy-reveal="fade">
      <div class="tab-bar" role="tablist">
        {steps.map((s, i) => (
          <button
            class:list={["tab-btn", { active: i === 0 }]}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`panel-${s.cat}`}
            data-tab={s.cat}
          >
            <span class="tab-num u-mono">{s.num}</span>
            <span class="tab-label">{s.label}</span>
          </button>
        ))}
        <span class="tab-indicator"></span>
      </div>

      {steps.map((s, i) => (
        <div
          class:list={["tab-panel", { active: i === 0 }]}
          role="tabpanel"
          id={`panel-${s.cat}`}
          data-panel={s.cat}
        >
          {(grouped[s.cat] ?? []).map(m => (
            <a href={`/dyfmaweb/maquinas/${m.id}`} class="machine-card">
              <div class="card-media">
                {m.image ? (
                  <img
                    src={m.image}
                    alt={m.name}
                    width="800"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="card-placeholder">Imagen pendiente</div>
                )}
                <span class="card-index u-mono">{String(steps.findIndex(x => x.cat === m.category) + 1).padStart(2, "0")}</span>
              </div>
              <div class="card-body">
                <h3 class="card-name">{m.name}</h3>
                <span class="card-name-en u-mono">{m.nameEn}</span>
                <p class="card-desc">{m.description}</p>
                <div class="card-specs">
                  {cardSpecs(m).map(sp => (
                    <div class="card-spec">
                      <span class="spec-label u-mono">{sp.label}</span>
                      <span class="spec-value">{sp.value}</span>
                    </div>
                  ))}
                </div>
                <span class="card-arrow">&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>

  </div>

  <TextMarquee class="marquee" texts={marqueeTexts} direction={-1} />
</div>

<script is:inline>
  (function() {
    const tabs = document.querySelectorAll("[data-tab]");
    const panels = document.querySelectorAll("[data-panel]");
    const indicator = document.querySelector(".tab-indicator");

    function activateTab(cat) {
      tabs.forEach(function(t) {
        var isActive = t.dataset.tab === cat;
        t.classList.toggle("active", isActive);
        t.setAttribute("aria-selected", isActive ? "true" : "false");
      });
      panels.forEach(function(p) {
        p.classList.toggle("active", p.dataset.panel === cat);
      });
      if (indicator) {
        var activeBtn = document.querySelector('[data-tab="' + cat + '"]');
        if (activeBtn) {
          indicator.style.width = activeBtn.offsetWidth + "px";
          indicator.style.left = activeBtn.offsetLeft + "px";
        }
      }
    }

    tabs.forEach(function(t) {
      t.addEventListener("click", function() {
        activateTab(t.dataset.tab);
        var bar = t.closest(".tab-bar");
        if (bar && bar.scrollWidth > bar.clientWidth) {
          var target = t.offsetLeft - (bar.clientWidth - t.offsetWidth) / 2;
          var max = bar.scrollWidth - bar.clientWidth;
          target = Math.max(0, Math.min(target, max));
          bar.scrollTo({ left: target, behavior: "smooth" });
        }
      });
    });

    var firstActive = document.querySelector("[data-tab].active");
    if (firstActive && indicator) {
      indicator.style.width = firstActive.offsetWidth + "px";
      indicator.style.left = firstActive.offsetLeft + "px";
    }
  })();
</script>

<style>
.gallery-text {
  margin: 6rem 0 0;
  padding: 6rem 0 0;
  position: relative;
  overflow: hidden;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 3rem;
  padding: 0 2rem;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 48rem;
}

.section-title {
  --fs: var(--type-display);
  --fw: 500;
  --lh: 0.98;
  font-family: var(--font-heading);
  font-size: var(--fs);
  font-weight: var(--fw);
  line-height: var(--lh);
  margin: 0.75rem 0 0;
  color: var(--color-brand-1);
  letter-spacing: -0.035em;
}

.section-body {
  --fs: var(--font-size-lg);
  max-width: 30em;
  margin: 1.25rem 0 0;
  font-family: var(--font-body);
  font-size: var(--fs);
  line-height: 1.55;
  color: var(--color-text-alt);
}

.cta { margin-top: 1.75rem; }

.tabs-wrap { width: 100%; }

.tab-bar {
  display: flex;
  gap: 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  position: relative;
  overflow-x: auto;
  scrollbar-width: none;
}

.tab-bar::-webkit-scrollbar { display: none; }

.tab-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.85rem 1.25rem;
  background: none;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  font-family: var(--font-body);
  color: var(--color-text-alt);
  transition: color 300ms ease;
}

.tab-btn:hover { color: var(--color-text); }
.tab-btn.active { color: var(--color-text); }

.tab-num {
  font-size: 0.6rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--color-text-alt);
  transition: color 300ms ease, background 300ms ease, border-color 300ms ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.tab-btn.active .tab-num {
  background: var(--color-brand-1);
  border-color: var(--color-brand-1);
  color: #fff;
}

.tab-label {
  font-size: var(--font-size-sm);
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.tab-indicator {
  position: absolute;
  bottom: -1px;
  height: 2px;
  background: var(--color-brand-1);
  transition: left 300ms cubic-bezier(0.22, 1, 0.36, 1), width 300ms cubic-bezier(0.22, 1, 0.36, 1);
  pointer-events: none;
}

.tab-panel { display: none; padding-top: 2rem; }

.tab-panel.active {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  gap: 1.25rem;
  animation: panelFade 350ms ease forwards;
}

@keyframes panelFade {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

.machine-card {
  display: flex;
  flex-direction: column;
  background: var(--color-surface);
  border: 1px solid rgba(255, 255, 255, 0.06);
  text-decoration: none;
  overflow: hidden;
  transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
              border-color 400ms cubic-bezier(0.22, 1, 0.36, 1),
              box-shadow 400ms cubic-bezier(0.22, 1, 0.36, 1);
}

.machine-card:hover,
.machine-card:focus-visible {
  transform: translateY(-4px);
  border-color: rgba(242, 140, 40, 0.35);
  box-shadow: 0 20px 40px -16px rgba(0, 0, 0, 0.25);
}

.card-media {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.03);
}

.card-media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
}

.machine-card:hover .card-media img {
  transform: scale(1.04);
}

.card-placeholder {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--color-text-alt);
  background: rgba(255, 255, 255, 0.03);
}

.card-index {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.card-body {
  display: flex;
  flex-direction: column;
  padding: 0.9rem 1rem 1rem;
  gap: 0.1rem;
  position: relative;
}

.card-name {
  font-family: var(--font-heading);
  font-size: clamp(0.85rem, 1.1vw, 1rem);
  font-weight: 500;
  color: var(--color-brand-1);
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 0;
}

.card-name-en {
  font-size: 0.58rem;
  color: var(--color-text-alt);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.card-desc {
  font-family: var(--font-body);
  font-size: var(--font-size-sm);
  line-height: 1.5;
  color: var(--color-text-alt);
  margin: 0.65rem 0 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-specs {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  margin-top: 0.65rem;
  padding-top: 0.6rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.card-spec {
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
}

.spec-label {
  font-size: 0.58rem;
  color: var(--color-text-alt);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
  flex-shrink: 0;
}

.spec-value {
  font-family: var(--font-body);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--color-text);
  transition: color 350ms ease;
}

.machine-card:hover .spec-value,
.machine-card:focus-visible .spec-value {
  color: var(--color-brand-1);
}

.card-arrow {
  align-self: flex-end;
  margin-top: 0.75rem;
  color: var(--color-text-alt);
  font-size: 1.1rem;
  transition: color 350ms ease, transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
}

.machine-card:hover .card-arrow,
.machine-card:focus-visible .card-arrow {
  color: var(--color-brand-1);
  transform: translateX(4px);
}

.marquee {
  z-index: 9;
  padding: 2rem 0;
  margin: 5rem 0 0;
  --c: var(--color-brand-1);
}

@media (--mq-tablet) {
  .gallery-text {
    margin: 4rem 0 0;
    padding: 4rem 0 0;
  }

  .container { padding: 0 1.5rem; }

  .section-title { --fs: var(--type-display-md); }

  .tab-panel.active {
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
  }
}

@media (--mq-phone) {
  .gallery-text {
    margin: 3rem 0 0;
    padding: 3rem 0 0;
  }

  .container { padding: 0 1rem; }

  .section-title { --fs: var(--type-title); }

  .section-body { --fs: var(--font-size-md); }

  .tab-btn { padding: 0.7rem 0.85rem; }

  .tab-label { font-size: 0.7rem; }

  /* Tabs deslizables horizontalmente */
  .tab-bar {
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }

  .tab-btn {
    scroll-snap-align: center;
    flex-shrink: 0;
  }

  /* Carrusel de máquinas con swipe */
  .tab-panel.active {
    display: flex;

    overflow-x: auto;

    scroll-snap-type: x mandatory;

    -webkit-overflow-scrolling: touch;

    gap: 1rem;

    padding: 2rem 1rem 1rem;

    margin: 0 -1rem;

    scrollbar-width: none;
  }

  .tab-panel.active::-webkit-scrollbar { display: none; }

  .tab-panel.active .machine-card {
    flex: 0 0 min(82%, 20rem);

    scroll-snap-align: center;
  }

  .card-desc {
    -webkit-line-clamp: 2;
  }
}
</style>
