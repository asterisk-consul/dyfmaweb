---
import type { Link } from "../types";
import Button from "./Button.astro";

interface Props {
  title: string;
  subtitle?: string;
  cta?: Link;

  /** Imagen del hero */
  imageSrc?: string;
  imageAlt?: string;
}

const {
  title,
  subtitle,
  cta,
  imageSrc,
  imageAlt = "",
} = Astro.props;
---

<div class="sy-hero-home">
  <div class="bg"></div>

  <div class="u-container container">
    <div class="inner">



      <div class="content">
        <h1 class="u-heading title" data-sy-reveal="words">
          {title}
        </h1>

        {subtitle ? (
          <p class="u-text subtitle" data-sy-reveal="lines">
            {subtitle}
          </p>
        ) : null}

        {cta ? <Button {...cta} arrow class="cta" /> : null}
      </div>

       {imageSrc ? (
        <div class="media" data-sy-reveal="fade">
          <img
            src={imageSrc}
            alt={imageAlt}
            loading="eager"
            decoding="async"
          />
        </div>
      ) : null}

      <div data-gl-place></div>
    </div>
  </div>
</div>

<style>
/* ===== Wrapper ===== */
.sy-hero-home {
  position: relative;
  overflow: hidden;
}

/* ===== Background gris técnico ===== */
.bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.bg::before {
  content: "";
  position: absolute;
  inset: 0;

  background: linear-gradient(
    180deg,
    #eeeeee 0%,
    #e3e3e3 25%,
    #d6d6d6 50%,
    #c4c4c4 75%,
    #b0b0b0 100%
  );

  mask: linear-gradient(
    180deg,
    rgba(0, 0, 0, 1) 80%,
    rgba(0, 0, 0, 0) 100%
  );
}

.bg::after {
  content: "";
  position: absolute;
  inset: 0;
  backdrop-filter: blur(4px);
}

/* ===== Layout ===== */
.inner {
  position: relative;
  z-index: 1;

  display: grid;
  grid-template-columns: 1.3fr 1fr;
  align-items: center;
  gap: 4rem;

  min-height: 100vh;
  padding: 9rem 0 10rem;
}

/* ===== Imagen ===== */
.media {
  position: relative;
  width: 120%;
  margin-left: -20%;

  /* Fade hacia la izquierda */
  mask-image: linear-gradient(
    270deg,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 1) 55%,
    rgba(0, 0, 0, 0.6) 70%,
    rgba(0, 0, 0, 0) 100%
  );
}

.media::after {
  content: "";
  position: absolute;
  inset: 0;

  backdrop-filter: blur(6px);

  mask-image: linear-gradient(
    270deg,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0) 50%,
    rgba(0, 0, 0, 1) 100%
  );

  pointer-events: none;
}

.media img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;

  filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.18));
}

/* ===== Texto ===== */
.content {
  position: relative;
  z-index: 2;
}

.title {
  --fw: 700;
  --fs: 4.5rem;
  --lh: 1;
  max-width: 8em;
}

.subtitle {
  --fs: var(--font-size-lg);
  max-width: 25em;
  margin-top: 1.5rem;
}

.cta {
  margin-top: 2rem;
}

/* ===== Responsive ===== */
@media (--mq-tablet) {
  .inner {
    grid-template-columns: 1fr;
    padding: 7rem 0 6rem;
  }

  .media {
    width: 100%;
    margin-left: 0;
    mask-image: none;
  }

  .media::after {
    display: none;
  }

  .content {
    margin-top: 2.5rem;
  }
}
</style>
