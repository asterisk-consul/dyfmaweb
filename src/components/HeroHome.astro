---
import type { Link } from "../types";
import Button from "./Button.astro";

interface Props {
  title: string;
  subtitle?: string;
  cta?: Link;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  title,
  subtitle,
  cta,
  imageSrc,
  imageAlt = "",
} = Astro.props;
---

<section class="hero-dyfma">
  <!-- Decorative architectural arcs -->
  <div class="hero-decoration" aria-hidden="true">
    <svg
      class="hero-arcs"
      viewBox="0 0 900 900"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M80 820V420C80 210 250 40 460 40"
        stroke="currentColor"
        stroke-width="1"
      />
      <path
        d="M120 820V430C120 240 270 80 460 80"
        stroke="currentColor"
        stroke-width="1"
      />
      <path
        d="M160 820V440C160 270 290 120 460 120"
        stroke="currentColor"
        stroke-width="1"
      />
    </svg>
  </div>

  <div class="hero-grid u-container container">

    <!-- Content -->
    <div class="content">

      <div class="eyebrow" data-sy-reveal="fade">
        <span class="eyebrow-line"></span>
        <span>TECNOLOGÍA PARA PROCESAMIENTO</span>
      </div>

      <h1 class="hero-title" data-sy-reveal="words">
        {title}
      </h1>

      {subtitle ? (
        <p class="hero-subtitle u-text" data-sy-reveal="lines">
          {subtitle}
        </p>
      ) : null}

      <div class="cta-wrapper">
        <Button title="Ver máquinas" url="#productos" arrow class="cta" revealable={false} />
        <Button title="Contactar" url="/dyfmaweb/contacto" color="primary-alt" class="cta cta-contact" revealable={false} />
      </div>

      <div class="nut-types" data-sy-reveal="fade">
        <span class="nut-label">PROCESAMOS</span>

        <div class="nut-tags">
          <span class="nut-tag">NUEZ CHANDLER</span>
          <span class="nut-tag">PECÁN</span>
          <span class="nut-tag">ALMENDRA</span>
          <span class="nut-tag">PISTACHO</span>
          <span class="nut-tag">AVELLANA</span>
        </div>
      </div>

    </div>

    <!-- Machine -->
    <div class="media" data-sy-reveal="fade">
      <div class="media-frame">
        <div class="media-number">01</div>

        <video
          class="hero-video"
          src="/dyfmaweb/LIMPIADORA-A-CAMPO.mp4"
          autoplay
          loop
          muted
          playsinline
        ></video>

        <div class="media-accent"></div>
      </div>
    </div>

  </div>

  <div class="hero-bottom" aria-hidden="true">
    <span>DYFMA</span>
    <span>PRECISIÓN · EFICIENCIA · TECNOLOGÍA</span>
  </div>
</section>

<style>
/* =========================================================
   HERO
   ========================================================= */

.hero-dyfma {
  position: relative;
  min-height: 100svh;

  display: flex;
  align-items: center;

  overflow: hidden;
  isolation: isolate;

  background: var(--color-bg);
}


/* =========================================================
   DECORATIVE ARCS
   ========================================================= */

.hero-decoration {
  position: absolute;

  top: -12%;
  right: -8%;

  width: min(65vw, 900px);
  aspect-ratio: 1;

  color: var(--color-brand-1);

  opacity: 0.11;

  pointer-events: none;

  z-index: -1;
}

.hero-arcs {
  width: 100%;
  height: 100%;
}


/* =========================================================
   MAIN GRID
   ========================================================= */

.hero-grid {
  position: relative;
  z-index: 2;

  width: 100%;

  display: grid;

  grid-template-columns:
    minmax(0, 0.9fr)
    minmax(0, 1.1fr);

  align-items: center;

  gap: clamp(2rem, 5vw, 5rem);

  padding: 6rem 0 4rem;
}


/* =========================================================
   CONTENT
   ========================================================= */

.content {
  position: relative;
  z-index: 3;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  min-width: 0;
}


/* =========================================================
   EYEBROW
   ========================================================= */

.eyebrow {
  display: flex;
  align-items: center;

  gap: 0.75rem;

  margin-bottom: 1.25rem;

  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 500;

  letter-spacing: 0.12em;
  text-transform: uppercase;

  color: var(--color-text-alt);
}

.eyebrow-line {
  width: 2rem;
  height: 1px;

  flex-shrink: 0;

  background: var(--color-brand-1);
}


/* =========================================================
   TITLE
   ========================================================= */

.hero-title {
  --fw: 500;
  --fs: var(--type-hero);
  --lh: 0.98;

  margin: 0;

  max-width: 8em;

  font-family: var(--font-heading);
  font-size: var(--fs);
  font-weight: var(--fw);
  line-height: var(--lh);

  letter-spacing: -0.035em;

  color: var(--color-text);
}


/* =========================================================
   SUBTITLE
   ========================================================= */

.hero-subtitle {
  --fs: var(--font-size-lg);

  max-width: 28em;

  margin: 1.25rem 0 0;

  font-family: var(--font-body);
  font-size: var(--fs);
  line-height: 1.45;

  color: var(--color-text-alt);
}


/* =========================================================
   CTA
   ========================================================= */

.cta-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1.75rem;
}

.cta {
  position: relative;
}

.cta-contact {
  --btn-txt-color: var(--color-white);
  --btn-bg-color: transparent;
  --btn-hover-bg-color: var(--color-brand-1);
  --btn-hover-text-color: var(--color-white);
}

.cta-contact > span > span {
  background: transparent !important;
  color: var(--color-white) !important;
}

.cta-contact > span::after {
  border-color: rgba(255, 255, 255, 0.4) !important;
}

.cta-contact:hover > span::after {
  border-color: var(--color-brand-1) !important;
}

.cta-contact:hover > span > span {
  background: var(--color-brand-1) !important;
  color: var(--color-white) !important;
}

.cta-contact > span > span:first-child {
  background: var(--color-brand-1) !important;
  color: var(--color-white) !important;
}


/* =========================================================
   NUT TYPES
   ========================================================= */

.nut-types {
  width: min(100%, 32rem);

  position: relative;

  margin-top: 2.5rem;
  padding-top: 1.1rem;

  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.nut-label {
  display: block;

  margin-bottom: 0.7rem;

  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 500;

  letter-spacing: 0.12em;
  text-transform: uppercase;

  color: var(--color-brand-1);
}

.nut-tags {
  display: flex;
  flex-wrap: wrap;

  gap: 0.35rem 0.75rem;
}

.nut-tag {
  position: relative;

  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 500;

  letter-spacing: 0.045em;
  text-transform: uppercase;

  color: var(--color-text-alt);

  transition:
    color 180ms ease,
    transform 180ms ease;
}

.nut-tag:not(:last-child)::after {
  content: "·";

  margin-left: 0.75rem;

  color: var(--color-brand-1);
}

.nut-tag:hover {
  color: var(--color-brand-1);

  transform: translateY(-1px);
}


/* =========================================================
   MACHINE MEDIA
   ========================================================= */

.media {
  position: relative;

  width: 100%;
  min-width: 0;
}

.media-frame {
  position: relative;

  width: 100%;

  padding: clamp(0.75rem, 1.5vw, 1.5rem);

  isolation: isolate;
}


/* Main architectural frame */
.media-frame::before {
  content: "";

  position: absolute;

  inset: 0;

  border: 1px solid rgba(242, 140, 40, 0.22);

  transform: translate(-0.9rem, 0.9rem);

  z-index: -1;
}


/* Secondary frame */
.media-frame::after {
  content: "";

  position: absolute;

  top: 1.5rem;
  right: 0;
  bottom: 0;
  left: 1.5rem;

  border: 1px solid rgba(255, 255, 255, 0.08);

  z-index: -2;
}


/* =========================================================
   MACHINE IMAGE
   ========================================================= */

.media img,
.media video {
  position: relative;

  display: block;

  width: 100%;
  height: auto;

  /*
   * Importante:
   * La imagen/video nunca debería ocupar todo el viewport.
   */
  max-height: 62svh;

  object-fit: cover;
  object-position: center;

  filter:
    drop-shadow(0 25px 45px rgba(0, 0, 0, 0.11));

  z-index: 2;
}


/* =========================================================
   IMAGE ORANGE ACCENT
   ========================================================= */

.media-accent {
  position: absolute;

  right: 0;
  bottom: 0;

  width: 5rem;
  height: 5rem;

  border-right: 3px solid var(--color-brand-1);
  border-bottom: 3px solid var(--color-brand-1);

  z-index: 3;
}


/* =========================================================
   IMAGE NUMBER
   ========================================================= */

.media-number {
  position: absolute;

  top: 0;
  left: 0;

  transform: translate(-50%, -50%);

  width: 2.5rem;
  height: 2.5rem;

  display: grid;
  place-items: center;

  background: var(--color-brand-1);
  color: #fff;

  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 500;

  z-index: 4;
}


/* =========================================================
   BOTTOM LABEL
   ========================================================= */

.hero-bottom {
  position: absolute;

  left: 0;
  right: 0;
  bottom: 1.25rem;

  padding: 0 clamp(1rem, 4vw, 4rem);

  display: flex;
  justify-content: space-between;
  align-items: center;

  font-family: var(--font-mono);
  font-size: 0.6rem;

  letter-spacing: 0.1em;
  text-transform: uppercase;

  color: var(--color-text-alt);

  opacity: 0.55;

  pointer-events: none;
}

.hero-bottom span:first-child {
  color: var(--color-brand-1);
  font-weight: 600;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (--mq-tablet) {

  .hero-dyfma {
    /*
     * En tablet ya no forzamos exactamente 100vh,
     * porque el contenido pasa a una sola columna.
     */
    height: auto;
    min-height: 100svh;
  }

  .hero-grid {
    grid-template-columns: 1fr;

    gap: 3.5rem;

    padding-top: 6rem;
    padding-bottom: 5rem;
  }


  /* Machine first */
  .media {
    order: -1;
  }

  .media-frame {
    width: min(100%, 800px);

    margin: 0 auto;
  }

  .media img,
  .media video {
    max-height: 45svh;
  }


  /* Center content */
  .content {
    align-items: center;

    text-align: center;
  }

  .eyebrow {
    justify-content: center;
  }

  .hero-title {
    --fs: var(--type-display);

    max-width: 12em;
  }

  .hero-subtitle {
    max-width: 36em;
  }


  /* Nuts */
  .nut-types {
    width: auto;
  }

  .nut-tags {
    justify-content: center;
  }


  /* Decoration */
  .hero-decoration {
    top: 0;
    right: -35%;

    width: 100vw;

    opacity: 0.08;
  }


  /* Hide bottom label */
  .hero-bottom {
    display: none;
  }
}


/* =========================================================
   PHONE
   ========================================================= */

@media (--mq-phone) {

  .hero-dyfma {
    height: auto;
    min-height: auto;
  }

  .hero-grid {
    gap: 2.5rem;

    padding-top: 5rem;
    padding-bottom: 4rem;
  }


  /* Title */
  .hero-title {
    --fs: var(--type-title);

    line-height: 1.02;
  }


  /* Subtitle */
  .hero-subtitle {
    --fs: var(--font-size-md);

    margin-top: 1.25rem;

    line-height: 1.5;
  }


  /* CTA */
  .cta-wrapper {
    margin-top: 1.75rem;
  }


  /* Image */
  .media-frame {
    padding: 0.5rem;
  }

  .media-frame::before {
    transform: translate(-0.5rem, 0.5rem);
  }

  .media-frame::after {
    top: 1rem;
    left: 1rem;
  }

  .media img,
  .media video {
    max-height: 32svh;
  }


  /* Image number */
  .media-number {
    width: 2rem;
    height: 2rem;

    font-size: 0.55rem;
  }


  /* Orange corner */
  .media-accent {
    width: 3rem;
    height: 3rem;
  }


  /* Nuts */
  .nut-types {
    margin-top: 2.5rem;
  }

  .nut-tag {
    font-size: 0.6rem;
  }


  /* Decoration */
  .hero-decoration {
    top: 5%;
    right: -55%;

    width: 130vw;
  }
}
</style>
