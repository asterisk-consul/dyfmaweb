---
// src/components/NutShell.astro
---

<sy-gl></sy-gl>

<script >
import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js";

class SyGL extends HTMLElement {
  connectedCallback() {
    this.style.position = "fixed";
    this.style.inset = "0";
    this.style.background = "#fff";

    const scene = new THREE.Scene();

    const camera = new THREE.OrthographicCamera(-2, 2, 2, -2, 0.1, 10);
    camera.position.z = 5;

    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    this.appendChild(renderer.domElement);

    /* -------- NUT OUTLINE (LINE ART) -------- */
    const shape = new THREE.Shape();

    shape.moveTo(0, 1);
    shape.bezierCurveTo(1.2, 1, 1.4, -0.2, 0, -1.4);
    shape.bezierCurveTo(-1.4, -0.2, -1.2, 1, 0, 1);

    const points = shape.getPoints(100);
    const geometry = new THREE.BufferGeometry().setFromPoints(points);

    const material = new THREE.LineBasicMaterial({
      color: 0x444444,
      linewidth: 2
    });

    const nutOutline = new THREE.LineLoop(geometry, material);
    scene.add(nutOutline);

    /* -------- INNER LINES (KERNEL) -------- */
    function innerCurve(scale, offsetX) {
      const s = new THREE.Shape();
      s.moveTo(offsetX, 0.6 * scale);
      s.bezierCurveTo(
        offsetX + 0.3 * scale, 0.6 * scale,
        offsetX + 0.4 * scale, -0.2 * scale,
        offsetX, -0.6 * scale
      );
      return new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(s.getPoints(50)),
        material
      );
    }

    scene.add(innerCurve(1, -0.4));
    scene.add(innerCurve(1, 0.4));

    /* -------- RENDER LOOP -------- */
    let isVisible = true;
    const visibilityObserver = new IntersectionObserver(entries => {
      isVisible = entries[0].isIntersecting;
    }, { threshold: 0 });
    visibilityObserver.observe(this);

    function animate() {
      if (isVisible) renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }
    animate();

    window.addEventListener("resize", () => {
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  }
}

customElements.define("sy-gl", SyGL);
</script>
