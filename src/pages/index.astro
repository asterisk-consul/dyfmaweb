---
import Layout from "../layouts/Layout.astro";
import HeroHome from "../components/HeroHome.astro";
import TextMarquee from "../components/TextMarquee.astro";
import GalleryText from "../components/GalleryText.astro";
import ImageMarquee from "../components/ImageMarquee.astro";
import Faqs from "../components/Faqs.astro";
import StepsTimeline from "../components/StepsTimeline.astro";
import Plans from "../components/Plans.astro";
import Statements from "../components/Statements.astro";
import Introducing from "../components/Introducing.astro";
import GL from "../components/GL.astro";
import GLPlaces from "../components/GlPlaces.astro";

import logo1 from "../assets/logoipsum-344.svg";
import logo2 from "../assets/logoipsum-350.svg";
import logo3 from "../assets/logoipsum-345.svg";
import logo4 from "../assets/logoipsum-385.svg";
import logo5 from "../assets/logoipsum-375.svg";
import logo6 from "../assets/logoipsum-378.svg";
import logo7 from "../assets/logoipsum-346.svg";
import logo8 from "../assets/logoipsum-331.svg";
---

<Layout title="Home">
  <HeroHome
    title="Soluciones Industriales para Pelado de Frutos Secos"
    subtitle="Maquinaria de alto rendimiento diseñada y fabricada en Argentina para optimizar la cosecha y postcosecha de nueces, almendras y otros frutos secos."
    imageSrc="/image-1.jpg",
    imageAlt="Línea industrial de pelado de frutos secos",
    cta={{
      title: "Conocé nuestros productos",
      url: "#",
    }}
  />

<Introducing
  title="Ingeniería aplicada al procesamiento de frutos secos"
  text="En DYFMA desarrollamos y fabricamos maquinaria industrial especializada en el pelado y procesamiento de frutos secos. Combinamos ingeniería, experiencia productiva y fabricación nacional para ofrecer soluciones eficientes, robustas y adaptadas a cada escala productiva."
  cta={{
    title: "Ver soluciones",
    url: "#productos",
  }}
/>


<StepsTimeline
  title="Nuestro proceso de trabajo"
  items={[
    {
      title: "Análisis productivo",
      text: "Evaluamos el tipo de fruto, volumen de producción y necesidades operativas para definir la solución más eficiente.",
    },
    {
      title: "Diseño y fabricación",
      text: "Desarrollamos equipos robustos con ingeniería propia, fabricados en Argentina y preparados para trabajo continuo.",
    },
    {
      title: "Implementación y soporte",
      text: "Acompañamos la puesta en marcha y brindamos soporte técnico para asegurar el máximo rendimiento del equipo.",
    },
  ]}
/>


<GalleryText
  title="Maquinaria diseñada para producir más"
  text="Cada equipo DYFMA está pensado para maximizar rendimiento, reducir mermas y garantizar un proceso estable y confiable en entornos industriales exigentes."
  cta={{
    title: "Explorar maquinaria",
    url: "#productos",
  }}
  images={[
    {
      alt: "Línea industrial de pelado de frutos secos",
      src: "/1.webp",
      width: 6000,
      height: 4000,
    },
    {
      alt: "Detalle de maquinaria DYFMA",
      src: "/2.webp",
      width: 2689,
      height: 4032,
    },
    {
      alt: "Proceso industrial de pelado",
      src: "/3.webp",
      width: 3734,
      height: 5359,
    },
  ]}
  marqueeTexts={[
    "Ingeniería Nacional",
    "Diseño Industrial",
    "Alta Productividad",
    "Procesos Confiables",
  ]}
/>

<Statements
  items={[
    {
      title: "Diseño industrial robusto",
      text: "Maquinaria desarrollada para operar de forma continua en entornos industriales exigentes, con máxima durabilidad y eficiencia.",
    },
    {
      title: "Escala productiva garantizada",
      text: "Soluciones que se adaptan tanto a producciones medianas como a plantas de alto volumen, acompañando el crecimiento de tu negocio.",
    },
    {
      title: "Resultados medibles",
      text: "Mayor rendimiento, menor merma y procesos optimizados para obtener un retorno real desde el primer día de operación.",
    },
  ]}
/>


 <TextMarquee
  class="marquee"
  texts={[
    "Ingeniería aplicada al agro",
    "Fabricación nacional",
    "Procesos industriales eficientes",
    "Soluciones para frutos secos",
  ]}
/>



  <Faqs
  title="Preguntas frecuentes"
  mobileTitle="FAQs"
  subtitle="Respuestas a las consultas más comunes sobre nuestras soluciones industriales."
  items={[
    {
      question: "¿Qué tipo de frutos secos procesa la maquinaria?",
      answer:
        "Nuestros equipos están diseñados principalmente para nuez pecán, nuez de castilla, almendras y otros frutos secos, según el requerimiento del cliente.",
    },
    {
      question: "¿Las máquinas se adaptan a distintos volúmenes de producción?",
      answer:
        "Sí. Desarrollamos soluciones para producciones medianas y grandes, con posibilidad de escalar líneas completas.",
    },
    {
      question: "¿La fabricación es nacional?",
      answer:
        "Sí. Diseñamos y fabricamos nuestros equipos en Argentina, lo que nos permite ofrecer soporte técnico cercano y repuestos.",
    },
    {
      question: "¿Ofrecen instalación y puesta en marcha?",
      answer:
        "Acompañamos la implementación del equipo y brindamos asistencia técnica para asegurar un funcionamiento óptimo.",
    },
    {
      question: "¿Cómo se solicita una cotización?",
      answer:
        "Podés contactarnos a través del formulario o por nuestros canales comerciales para evaluar tu necesidad productiva.",
    },
  ]}
/>


