---
import Layout from "../layouts/Layout.astro";
import HeroHome from "../components/HeroHome.astro";
import TextMarquee from "../components/TextMarquee.astro";
import GalleryText from "../components/GalleryText.astro";
import Faqs from "../components/Faqs.astro";
import StepsTimeline from "../components/StepsTimeline.astro";
import Statements from "../components/Statements.astro";
import Testimonials from "../components/Testimonials.astro";
import Introducing from "../components/Introducing.astro";
import LatamMapGraphic from "../components/LatamMapGraphic.astro";
---

<Layout title="DYFMA — Máquinas para producción de frutos secos">
  <HeroHome
    title="Ingeniería y fabricación de soluciones para frutos secos"
    subtitle="Diseñamos y fabricamos maquinaria especializada en cosecha, procesamiento y agregado de valor. Más de 12 años acompañando a productores de Argentina y la región."
    imageSrc="/dyfmaweb/1.webp",
    imageAlt="Partidora de nuez DALL 1050 — maquinaria DYFMA",
    cta={{
      title: "Ver soluciones",
      url: "/dyfmaweb/maquinas",
    }}
  />

  <div class="section-glow glow-gallery" aria-hidden="true">
    <GalleryText
      title="Maquinaria disenada para producir mas"
      text="Cada equipo DYFMA esta pensado para maximizar rendimiento, reducir mermas y garantizar un proceso estable y confiable en entornos industriales exigentes."
      cta={{
        title: "Explorar maquinaria",
        url: "/dyfmaweb/maquinas",
      }}
      marqueeTexts={[
        "NUEZ CHANDLER",
        "PECAN",
        "ALMENDRA",
        "PISTACHO",
        "AVELLANA",
      ]}
      class="section-connector"
    />
  </div>

  <div class="section-glow glow-modular" aria-hidden="true">
    <Introducing
      title="Crecé a tu ritmo — soluciones modulares que escalan con tu produccion"
      text="En DYFMA creemos que tu línea de producción tiene que crecer junto con tu negocio. Por eso desarrollamos soluciones modulares: podés comenzar con una máquina y sumar nuevos equipos a medida que aumenta tu producción, hasta completar toda la línea."
      textExtra="Una solución pensada para que inviertas de manera progresiva y puedas adaptar tu planta a las necesidades de cada etapa de crecimiento."
      cta={{
        title: "Ver soluciones",
        url: "/dyfmaweb/maquinas",
      }}
      class="section-connector"
    >
      <video
        slot="media"
        src="/dyfmaweb/LineaPeladoraPecan.mp4"
        autoplay
        loop
        muted
        playsinline
      ></video>
    </Introducing>
  </div>

  <div class="section-glow glow-intro" aria-hidden="true">
    <Introducing
      title="Del diseno a la maquina — fabricacion argentina para toda Sudamerica"
      text="En DYFMA desarrollamos y fabricamos maquinaria industrial para la cosecha, procesamiento y agregado de valor de frutos secos. Combinamos ingenieria propia, fabricacion nacional y mas de 12 anos de experiencia para ofrecer soluciones que permiten al productor procesar mejor y ganar mas."
      cta={{
        title: "Ver soluciones",
        url: "/dyfmaweb/maquinas",
      }}
      class="section-connector"
    >
      <LatamMapGraphic slot="media" />
    </Introducing>
  </div>
    <div class="section-glow glow-canje" aria-hidden="true">
    <section class="canje">
      <div class="u-container">
        <div class="canje-grid">
          <div class="canje-media" data-sy-reveal="fade">
            <img
              src="/dyfmaweb/plancanje.jpeg"
              alt="Plan Canje DYFMA — entregá tu máquina usada y renová por una nueva"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="canje-content">
            <div class="u-eyebrow" data-sy-reveal="fade">
              <span class="u-eyebrow-line"></span>
              <span>PLAN CANJE</span>
            </div>

            <h2 class="canje-title" data-sy-reveal="words">
              Renová tu maquina — Plan Canje DYFMA
            </h2>

            <p class="canje-text" data-sy-reveal="lines">
              Entregas tu maquina usada, abonas la diferencia y te llevas una
              maquina DYFMA nueva, con tecnologia de fabricacion nacional y el
              respaldo de quien la construyo. Una forma mas accesible de
              renovar tu equipamiento y mejorar tu productividad.
            </p>

            <a
              href="/dyfmaweb/plan-canje"
              class="canje-btn"
              data-sy-reveal="fade"
            >
              Conoce mas sobre el Plan Canje
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="section-glow glow-steps" aria-hidden="true">
    <StepsTimeline
      title="Como trabajamos"
      items={[
        {
          title: "Fabricamos",
          text: "Disenamos y fabricamos nuestras propias soluciones en Villa Maria, Cordoba. Cada maquina nace de una necesidad real del productor.",
          video: "/dyfmaweb/Fabricacion.mp4",
        },
        {
          title: "Resolvemos",
          text: "Partimos de las necesidades de cada productor para desarrollar la tecnologia adecuada. Asesoramiento personalizado sin presion de venta.",
          image: "/dyfmaweb/3.webp",
        },
        {
          title: "Prueba en Fabrica",
          text: "Probamos tu solucion con tu propio fruto antes de entregarla. Rendimiento, calidad y funcionamiento verificados en planta — el resultado, comprobado.",
          video: "/dyfmaweb/pruebaMaquina.mp4",
        },
      ]}
      class="section-connector"
    />
  </div>

    <Testimonials
    title="Los productores hablan"
    subtitle="Historias reales de quienes trabajan todos los días con nuestras máquinas."
    items={[
      { video: "/dyfmaweb/testimonios/testimonio-1.mp4", name: "Cliente DYFMA", role: "TESTIMONIO 01" },
      { video: "/dyfmaweb/testimonios/testimonio-2.mp4", name: "Cliente DYFMA", role: "TESTIMONIO 02" },
      { video: "/dyfmaweb/testimonios/testimonio-3.mp4", name: "Cliente DYFMA", role: "TESTIMONIO 03" },
      { video: "/dyfmaweb/testimonios/testimonio-4.mp4", name: "Cliente DYFMA", role: "TESTIMONIO 04" },
      { video: "/dyfmaweb/testimonios/testimonio-5.mp4", name: "Cliente DYFMA", role: "TESTIMONIO 05" },
      { video: "/dyfmaweb/testimonios/testimonio-6.mp4", name: "Cliente DYFMA", role: "TESTIMONIO 06" },
      { video: "/dyfmaweb/testimonios/testimonio-7.mp4", name: "Cliente DYFMA", role: "TESTIMONIO 07" },
    ]}
    class="section-connector"
  />

  <Statements
    items={[
      {
        title: "Fabricación propia",
        text: "Somos fabricantes y desarrolladores. Diseñamos, fabricamos, instalamos y damos soporte — todo desde Villa María, Córdoba.",
      },
      {
        title: "+200 equipos instalados",
        text: "Más de 12 años de experiencia y más de 200 puntos de instalación en 18 provincias argentinas y 4 países de la región.",
      },
      {
        title: "Repuestos y soporte local",
        text: "Cuando algo falla, el repuesto llega de Villa María, no de Italia o China. Llamás y hablás con quien fabricó tu máquina.",
      },
    ]}
    class="section-connector"
  />



  <TextMarquee
    class="marquee"
    texts={[
      "Transformamos producción en valor",
      "Ingeniería argentina para frutos secos",
      "+200 máquinas en 18 provincias",
      "Del diseño a la máquina — fabricación propia",
      "Soluciones para cosecha y poscosecha",
    ]}
    direction={-1}
  />

  <div class="section-glow glow-faqs" aria-hidden="true">
    <Faqs
      title="Preguntas frecuentes"
      mobileTitle="FAQs"
      subtitle="Respuestas a las consultas más comunes sobre nuestras soluciones."
      items={[
        {
          question: "Que tipo de frutos procesa la maquinaria?",
          answer:
            "Nuestros equipos estan disenados para nuez Chandler, nuez pecan, almendras, pistacho y avellanas, segun el requerimiento del cliente.",
        },
        {
          question: "Las maquinas se adaptan a distintos volumenes de produccion?",
          answer:
            "Si. Desarrollamos soluciones para producciones medianas y grandes, con posibilidad de escalar lineas completas.",
        },
        {
          question: "La fabricacion es nacional?",
          answer:
            "Si. Disenamos y fabricamos nuestros equipos en Villa Maria, Cordoba, lo que nos permite ofrecer tecnico cercano y repuestos.",
        },
        {
          question: "Puedo comprar una sola maquina o necesito una linea completa?",
          answer:
            "Trabajamos tanto con maquinas individuales como con lineas completas de procesamiento. Cada solucion se adapta a la escala del productor.",
        },
        {
          question: "Como se solicita una cotizacion?",
          answer:
            "Podes contactarnos a traves del formulario o al +549 3534 11-8602. Evaluamos cada necesidad y te asesoramos sin compromiso.",
        },
      ]}
    />
  </div>

  <!-- Closing CTA Band -->
  <section class="closing-cta">
    <video
      class="cta-video"
      src="/dyfmaweb/recolector manual.mp4"
      autoplay
      loop
      muted
      playsinline
    ></video>
    <div class="cta-overlay"></div>
    <div class="u-container">
      <div class="cta-eyebrow" data-sy-reveal="fade">
        <span class="cta-eyebrow-line"></span>
        <span>PROXIMO PASO</span>
      </div>
      <h2 class="cta-title" data-sy-reveal="words">Listo para procesar mejor?</h2>
      <p class="cta-text u-text" data-sy-reveal="lines">Hbla con nuestro equipo y disenamos la solucion ideal para tu produccion.</p>
      <div class="cta-actions">
        <a href="https://wa.me/5493534118602" target="_blank" rel="noopener" class="cta-btn cta-btn-wsp">
          <svg class="wsp-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span class="cta-btn-label">WhatsApp</span>
        </a>
        <a href="/dyfmaweb/contacto" class="cta-btn cta-btn-contact">
          <span class="cta-btn-label">Contacto</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .marquee {
    padding: 2rem 0;
    z-index: 9;
  }

  /* =========================================================
     GLOW WRAPPERS
     ========================================================= */
  .section-glow {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
  }

  .section-glow::before {
    content: "";
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .glow-gallery::before {
    width: 40rem;
    height: 40rem;
    top: -10rem;
    right: -8rem;
    background: radial-gradient(circle, rgba(242, 140, 40, 0.10), transparent 70%);
  }

  .glow-modular::before {
    width: 35rem;
    height: 35rem;
    top: -8rem;
    left: -8rem;
    background: radial-gradient(circle, rgba(242, 140, 40, 0.10), transparent 70%);
  }

  .glow-intro::before {
    width: 35rem;
    height: 35rem;
    bottom: -8rem;
    left: -6rem;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.06), transparent 70%);
  }

  .glow-steps::before {
    width: 30rem;
    height: 30rem;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(242, 140, 40, 0.08), transparent 70%);
  }

  .glow-faqs::before {
    width: 30rem;
    height: 30rem;
    top: -6rem;
    right: -4rem;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.06), transparent 70%);
  }

  .glow-canje::before {
    width: 32rem;
    height: 32rem;
    bottom: -6rem;
    right: -6rem;
    background: radial-gradient(circle, rgba(242, 140, 40, 0.10), transparent 70%);
  }

  /* =========================================================
     PLAN CANJE SUMMARY
     ========================================================= */
  .canje {
    padding: clamp(4rem, 8vw, 7rem) 0;
    position: relative;
    z-index: 2;
  }

  .canje-grid {
    display: grid;

    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);

    align-items: center;

    gap: clamp(3rem, 6vw, 6rem);

    width: min(100%, 72rem);

    margin: 0 auto;
  }

  .canje-media {
    position: relative;

    height: 100%;

    min-height: 24rem;
  }

  .canje-media img {
    display: block;

    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center top;

    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.07));
  }

  .canje-media::after {
    content: "";

    position: absolute;

    right: -1rem;
    bottom: -1rem;

    width: 4.5rem;
    height: 4.5rem;

    border-right: 3px solid var(--color-brand-1);
    border-bottom: 3px solid var(--color-brand-1);

    pointer-events: none;
  }

  .canje-title {
    --fs: var(--type-display);
    --lh: 0.98;
    --fw: 500;

    margin: 1.25rem 0 0;

    max-width: 12em;

    font-family: var(--font-heading);

    font-size: var(--fs);
    font-weight: var(--fw);
    line-height: var(--lh);

    letter-spacing: -0.01em;

    color: var(--color-brand-1);
  }

  .canje-text {
    margin: 1.5rem 0 0;

    max-width: 34em;

    font-size: var(--font-size-lg);
    line-height: 1.55;

    color: var(--color-text-alt);
  }

  .canje-btn {
    display: inline-flex;

    align-items: center;

    margin-top: 2rem;

    padding: 0.85rem 1.75rem;

    background: var(--color-brand-1);
    color: #fff;

    text-decoration: none;

    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--font-size-md);

    transition: background 0.2s ease, color 0.2s ease;
  }

  .canje-btn:hover {
    background: var(--color-white);
    color: var(--color-brand-1);
  }

  @media (--mq-desktop-md) {
    .canje-grid {
      gap: 3rem;
    }
  }

  @media (--mq-tablet) {
    .canje-grid {
      grid-template-columns: 1fr;

      gap: 3rem;
    }

    .canje-media {
      width: min(100%, 32rem);

      margin: 0 auto;
    }

    .canje-content {
      text-align: center;

      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .canje-title {
      max-width: 14em;
    }
  }

  @media (--mq-phone) {
    .canje-title {
      --fs: var(--type-title);

      line-height: 1.02;
    }

    .canje-text {
      font-size: var(--font-size-md);

      margin-top: 1.25rem;
    }
  }

  /* =========================================================
     CLOSING CTA
     ========================================================= */
  .closing-cta {
    background: var(--color-bg);
    color: var(--color-white);
    padding: 5rem 0;
    text-align: center;
    position: relative;
    z-index: 9;
    overflow: hidden;
  }

  .cta-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(242, 140, 40, 0.78);
    z-index: 1;
  }

  .closing-cta .u-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    position: relative;
    z-index: 2;
  }

  .cta-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .cta-eyebrow-line {
    width: 2rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.5);
    flex-shrink: 0;
  }

  .cta-title {
    --fs: var(--type-display);
    --lh: 1;
    --fw: 500;
    font-family: var(--font-heading);
    font-size: var(--fs);
    color: var(--color-white);
    margin: 0;
    letter-spacing: -0.03em;
  }

  .cta-text {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    color: rgba(255, 255, 255, 0.9);
    max-width: 30em;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-btn {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    background: var(--color-white);
    color: var(--color-brand-1);
    border: 2px solid var(--color-white);
    border-radius: 0;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--font-size-md);
    transition: all 0.2s ease;
  }

  .cta-btn:hover {
    background: transparent;
    color: var(--color-white);
    border-color: var(--color-white);
  }

  .cta-btn-contact {
    background: transparent;
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .cta-btn-contact:hover {
    background: var(--color-white);
    color: var(--color-brand-1);
    border-color: var(--color-white);
  }

  .wsp-icon {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }

  .cta-btn-label {
    font-weight: 600;
  }

  .cta-btn-phone {
    font-size: var(--font-size-xs);
    opacity: 0.8;
  }

  @media (--mq-tablet) {
    .closing-cta {
      padding: 3.5rem 0;
    }

    .cta-title {
      --fs: var(--type-display-md);
    }
  }

  @media (--mq-phone) {
    .closing-cta {
      padding: 3rem 0;
    }

    .cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-btn {
      width: 100%;
    }
  }
</style>
