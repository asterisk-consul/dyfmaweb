---
import Layout from "../layouts/Layout.astro";
import HeroHome from "../components/HeroHome.astro";
import TextMarquee from "../components/TextMarquee.astro";
import GalleryText from "../components/GalleryText.astro";
import Faqs from "../components/Faqs.astro";
import StepsTimeline from "../components/StepsTimeline.astro";
import Statements from "../components/Statements.astro";
import Introducing from "../components/Introducing.astro";
import LatamMapGraphic from "../components/LatamMapGraphic.astro";
---

<Layout title="DYFMA — Máquinas para producción de frutos secos">
  <HeroHome
    title="Ingeniería y fabricación de soluciones para frutos secos"
    subtitle="Diseñamos y fabricamos maquinaria especializada en cosecha, procesamiento y agregado de valor. Más de 12 años acompañando a productores de Argentina y la región."
    imageSrc="/dyfmaweb/1.webp",
    imageAlt="Partidora de nuez DALL 1050 — maquinaria DYFMA",
    cta={{
      title: "Ver soluciones",
      url: "#productos",
    }}
  />

  <Introducing
    title="Del diseño a la máquina — fabricación argentina para toda Sudamérica"
    text="En DYFMA desarrollamos y fabricamos maquinaria industrial para la cosecha, procesamiento y agregado de valor de frutos secos. Combinamos ingeniería propia, fabricación nacional y más de 12 años de experiencia para ofrecer soluciones que permiten al productor procesar mejor y ganar más."
    cta={{
      title: "Ver soluciones",
      url: "#productos",
    }}
    class="section-connector"
  >
    <LatamMapGraphic slot="media" />
  </Introducing>

  <StepsTimeline
    title="Cómo trabajamos"
    items={[
      {
        title: "Fabricamos",
        text: "Diseñamos y fabricamos nuestras propias soluciones en Villa María, Córdoba. Cada máquina nace de una necesidad real del productor.",
        image: "/dyfmaweb/1.webp",
      },
      {
        title: "Resolvemos",
        text: "Partimos de las necesidades de cada productor para desarrollar la tecnología adecuada. Asesoramiento personalizado sin presión de venta.",
        image: "/dyfmaweb/3.webp",
      },
      {
        title: "Agregamos valor",
        text: "Transformamos la producción para que el productor pueda procesar su cosecha, mejorar su eficiencia y obtener un mayor retorno.",
        image: "/dyfmaweb/elevador.png",
      },
    ]}
    class="section-connector"
  />

  <GalleryText
    title="Maquinaria diseñada para producir más"
    text="Cada equipo DYFMA está pensado para maximizar rendimiento, reducir mermas y garantizar un proceso estable y confiable en entornos industriales exigentes."
    cta={{
      title: "Explorar maquinaria",
      url: "#productos",
    }}
    images={[
      {
        alt: "Línea industrial de pelado de frutos secos",
        src: "/dyfmaweb/1.webp",
        width: 6000,
        height: 4000,
      },
      {
        alt: "Detalle de maquinaria DYFMA",
        src: "/dyfmaweb/2.webp",
        width: 2689,
        height: 4032,
      },
      {
        alt: "Proceso industrial de pelado",
        src: "/dyfmaweb/3.webp",
        width: 3734,
        height: 5359,
      },
    ]}
    marqueeTexts={[
      "NUEZ CHANDLER",
      "PECÁN",
      "ALMENDRA",
      "PISTACHO",
      "AVELLANA",
    ]}
    class="section-connector"
  />

  <Statements
    items={[
      {
        title: "Fabricación propia",
        text: "Somos fabricantes y desarrolladores. Diseñamos, fabricamos, instalamos y damos soporte — todo desde Villa María, Córdoba.",
      },
      {
        title: "+200 equipos instalados",
        text: "Más de 12 años de experiencia y más de 200 puntos de instalación en 18 provincias argentinas y 4 países de la región.",
      },
      {
        title: "Repuestos y soporte local",
        text: "Cuando algo falla, el repuesto llega de Villa María, no de Italia o China. Llamás y hablás con quien fabricó tu máquina.",
      },
    ]}
    class="section-connector"
  />

  <TextMarquee
    class="marquee"
    texts={[
      "Transformamos producción en valor",
      "Ingeniería argentina para frutos secos",
      "+200 máquinas en 18 provincias",
      "Del diseño a la máquina — fabricación propia",
      "Soluciones para cosecha y poscosecha",
    ]}
    direction={-1}
  />

  <Faqs
    title="Preguntas frecuentes"
    mobileTitle="FAQs"
    subtitle="Respuestas a las consultas más comunes sobre nuestras soluciones."
    items={[
      {
        question: "¿Qué tipo de frutos procesa la maquinaria?",
        answer:
          "Nuestros equipos están diseñados para nuez Chandler, nuez pecán, almendras, pistacho y avellanas, según el requerimiento del cliente.",
      },
      {
        question: "¿Las máquinas se adaptan a distintos volúmenes de producción?",
        answer:
          "Sí. Desarrollamos soluciones para producciones medianas y grandes, con posibilidad de escalar líneas completas.",
      },
      {
        question: "¿La fabricación es nacional?",
        answer:
          "Sí. Diseñamos y fabricamos nuestros equipos en Villa María, Córdoba, lo que nos permite ofrecer soporte técnico cercano y repuestos.",
      },
      {
        question: "¿Puedo comprar una sola máquina o necesito una línea completa?",
        answer:
          "Trabajamos tanto con máquinas individuales como con líneas completas de procesamiento. Cada solución se adapta a la escala del productor.",
      },
      {
        question: "¿Cómo se solicita una cotización?",
        answer:
          "Podés contactarnos a través del formulario o al +549 3534 11-8602. Evaluamos cada necesidad y te asesoramos sin compromiso.",
      },
    ]}
  />

  <!-- Closing CTA Band -->
  <section class="closing-cta">
    <div class="u-container">
      <div class="cta-eyebrow" data-sy-reveal="fade">
        <span class="cta-eyebrow-line"></span>
        <span>PRÓXIMO PASO</span>
      </div>
      <h2 class="cta-title" data-sy-reveal="words">¿Listo para procesar mejor?</h2>
      <p class="cta-text u-text" data-sy-reveal="lines">Hablá con nuestro equipo y diseñamos la solución ideal para tu producción.</p>
      <div class="cta-actions">
        <a href="tel:+5493534118602" class="cta-btn">
          <span class="cta-btn-label">Llamar ahora</span>
          <span class="cta-btn-phone u-mono">+549 3534 11-8602</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .marquee {
    padding: 2rem 0;
    z-index: 9;
  }

  .closing-cta {
    background: var(--color-brand-1);
    color: var(--color-white);
    padding: 6rem 0;
    text-align: center;
    position: relative;
    z-index: 9;
  }

  .closing-cta .u-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .cta-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }

  .cta-eyebrow-line {
    width: 2rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.5);
    flex-shrink: 0;
  }

  .cta-title {
    --fs: var(--type-display);
    --lh: 1;
    --fw: 500;
    font-size: var(--fs);
    color: var(--color-white);
    margin: 0;
    letter-spacing: -0.03em;
  }

  .cta-text {
    font-size: var(--font-size-lg);
    color: rgba(255, 255, 255, 0.85);
    max-width: 30em;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 1rem 2rem;
    background: var(--color-white);
    color: var(--color-brand-1);
    border: 2px solid var(--color-white);
    border-radius: 0;
    text-decoration: none;
    font-weight: 600;
    font-size: var(--font-size-md);
    transition: all 0.2s ease;
  }

  .cta-btn:hover {
    background: transparent;
    color: var(--color-white);
  }

  .cta-btn-label {
    font-weight: 600;
  }

  .cta-btn-phone {
    font-size: var(--font-size-xs);
    opacity: 0.8;
  }

  @media (--mq-tablet) {
    .closing-cta {
      padding: 4rem 0;
    }

    .cta-title {
      --fs: var(--type-display-md);
    }
  }

  @media (--mq-phone) {
    .cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-btn {
      width: 100%;
    }
  }
</style>
