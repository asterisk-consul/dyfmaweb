---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import { machines, categoryLabels } from "../../data/machines";

export function getStaticPaths() {
  return machines.map((machine) => ({
    params: { id: machine.id },
    props: { machine },
  }));
}

const { machine } = Astro.props;

const parentLines = machines.filter(
  (m) => m.role === "line" && m.modules?.some((mod) => mod.machineId === machine.id)
);
---

<Layout title={`${machine.name} — DYFMA`}>
  <div class="machine-page">
    <div class="u-container container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href="/dyfmaweb/">Inicio</a>
        <span class="sep">/</span>
        <a href="/dyfmaweb/maquinas">Máquinas</a>
        <span class="sep">/</span>
        <span class="current">{machine.name}</span>
      </nav>

      <div class="inner">
        <!-- Content -->
        <div class="content">
          <span class="category-tag u-spec">{categoryLabels[machine.category]}</span>
          <h1 class="machine-title">{machine.name}</h1>
          <p class="machine-subtitle">
            {machine.subtitle ??
              machine.specs.slice(0, 3).map((s) => s.value).join(" · ")}
          </p>
          <p class="machine-desc">{machine.description}</p>

          <!-- Parte de una línea (módulos) -->
          {parentLines.length > 0 && (
            <p class="line-parent">
              <span class="line-parent-label u-spec">Parte de</span>
              <span class="line-parent-lines">
                {parentLines.map((line) => (
                  <a href={`/dyfmaweb/maquinas/${line.id}`}>{line.name}</a>
                ))}
              </span>
            </p>
          )}

          <!-- Composición de la línea -->
          {machine.modules && (
            <div class="line-composition">
              <span class="line-composition-title u-spec">Composición de la línea</span>
              <ul class="composition-list">
                {machine.modules.map((mod) => (
                  <li>
                    {mod.machineId ? (
                      <a class="composition-item" href={`/dyfmaweb/maquinas/${mod.machineId}`}>
                        <span class="composition-dot" aria-hidden="true"></span>
                        <span>{mod.name}</span>
                        {mod.note ? <span class="composition-note u-mono">{mod.note}</span> : null}
                      </a>
                    ) : (
                      <span class="composition-item">
                        <span class="composition-dot" aria-hidden="true"></span>
                        <span>{mod.name}</span>
                        {mod.note ? <span class="composition-note u-mono">{mod.note}</span> : null}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Specs table -->
          <div class="specs-table">
            {machine.specs.map((spec) => (
              <div class="spec-row">
                <span class="spec-label">{spec.label}</span>
                <span class="spec-value u-mono">{spec.value}</span>
              </div>
            ))}
          </div>

          <!-- Features -->
          {machine.features && (
            <ul class="features">
              {machine.features.map((feature) => (
                <li class="feature">
                  <span class="feature-check">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M12 2.5 4 5.5v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10v-6L12 2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                      <path d="m8.5 12 2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <div>
                    <h3 class="feature-title">{feature.title}</h3>
                    <p class="feature-text">{feature.text}</p>
                  </div>
                </li>
              ))}
            </ul>
          )}

          <!-- Detail (expandible) -->
          {machine.detail && (
            <div class="detail" data-detail>
              <p class="detail-text" data-detail-text>{machine.detail}</p>
              <button type="button" class="detail-toggle" data-detail-toggle aria-expanded="false">
                <span class="detail-toggle-more">Ver más</span>
                <span class="detail-toggle-less">Ver menos</span>
              </button>
            </div>
          )}

          <!-- CTA -->
          <div class="actions">
            <Button
              title="Solicitar cotización"
              url="/dyfmaweb/contacto"
              arrow
            />

            {machine.pdf ? (
              <a href={machine.pdf} download class="pdf-btn">
                <svg class="pdf-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M12 3v12m0 0 4-4m-4 4-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
                Ficha técnica
              </a>
            ) : (
              <Button
                title="Ver todas las máquinas"
                url="/dyfmaweb/maquinas"
                class="secondary"
              />
            )}
          </div>
        </div>

        <!-- Gallery + Quality card -->
        <div class="media">
          <div class="gallery" data-gallery>
            <div class="gallery-stage" data-gallery-open>
              {machine.media.map((item, i) => (
                <div class:list={["gallery-item", i === 0 && "is-active"]} data-index={i}>
                  {item.type === "video" ? (
                    <video
                      src={item.src}
                      muted
                      loop
                      playsinline
                      preload="metadata"
                    ></video>
                  ) : (
                    <img
                      src={item.src}
                      alt={`${machine.name} — imagen ${i + 1}`}
                      width="800"
                      height="600"
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  )}
                </div>
              ))}

              {machine.media.length > 1 && (
                <>
                  <button type="button" class="gallery-arrow prev" data-gallery-prev aria-label="Anterior">
                    &lsaquo;
                  </button>
                  <button type="button" class="gallery-arrow next" data-gallery-next aria-label="Siguiente">
                    &rsaquo;
                  </button>
                </>
              )}

              <div class="gallery-counter u-mono">
                <span data-gallery-current>01</span>
                <span class="gallery-counter-sep">/</span>
                <span>{String(machine.media.length).padStart(2, "0")}</span>
              </div>

              {machine.media.length > 1 && (
                <div class="gallery-dots" role="tablist" aria-label="Galería">
                  {machine.media.map((_, i) => (
                    <button
                      type="button"
                      class:list={["gallery-dot", i === 0 && "is-active"]}
                      data-gallery-dot={i}
                      aria-label={`Ir a ${i + 1}`}
                    ></button>
                  ))}
                </div>
              )}
            </div>
          </div>

          <!-- Card CALIDAD DYFMA -->
          <div class="quality-card">
            <svg class="quality-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 2.5 4 5.5v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10v-6L12 2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              <path d="m8.5 12 2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div class="quality-text">
              <p class="quality-title u-spec">Calidad DYFMA</p>
              <p class="quality-desc">Equipos diseñados y fabricados para brindar rendimiento, durabilidad y eficiencia en cada campaña.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Back link -->
      <a href="/dyfmaweb/maquinas" class="back-link">
        ← Volver a máquinas
      </a>
    </div>
  </div>

  <!-- Lightbox -->
  <div class="lightbox" data-lightbox hidden>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Cerrar">&#10005;</button>

    <div class="lightbox-stage">
      {machine.media.map((item, i) => (
        <div class:list={["lightbox-item", i === 0 && "is-active"]} data-index={i}>
          {item.type === "video" ? (
            <video
              src={item.src}
              muted
              loop
              playsinline
              controls
              preload="metadata"
            ></video>
          ) : (
            <img
              src={item.src}
              alt={`${machine.name} — imagen ${i + 1}`}
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      ))}

      {machine.media.length > 1 && (
        <>
          <button type="button" class="gallery-arrow prev" data-lightbox-prev aria-label="Anterior">&lsaquo;</button>
          <button type="button" class="gallery-arrow next" data-lightbox-next aria-label="Siguiente">&rsaquo;</button>
          <div class="gallery-counter u-mono">
            <span data-lightbox-current>01</span>
            <span class="gallery-counter-sep">/</span>
            <span>{String(machine.media.length).padStart(2, "0")}</span>
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<style>
  .machine-page {
    padding: 8rem 0 4rem;
    min-height: 100vh;
    background: var(--color-bg);
  }

  .container {
    max-width: 1180px;
  }

  /* Breadcrumb */
  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-alt);
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb a {
    color: var(--color-text-alt);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-brand-1);
  }

  .breadcrumb .sep {
    opacity: 0.4;
  }

  .breadcrumb .current {
    color: var(--color-text);
  }

  /* Layout */
  .inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Content */
  .content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .category-tag {
    color: var(--color-brand-1);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .machine-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-brand-1);
    margin: 0;
  }

  .machine-name-en {
    font-size: 0.8rem;
    color: var(--color-text-alt);
    margin: 0;
  }

  .machine-subtitle {
    margin: 1rem 0 0;

    font-size: var(--font-size-lg);
    font-weight: 500;

    color: var(--color-text);
  }

  .machine-desc {
    margin: 1.25rem 0 0;

    font-size: var(--font-size-md);
    color: var(--color-text-alt);
    line-height: 1.65;
  }

  /* Parte de una línea (módulos) */
  .line-parent {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;

    margin: 1rem 0 0;

    font-size: var(--font-size-sm);
    color: var(--color-text-alt);
  }

  .line-parent-label {
    color: var(--color-brand-1);
  }

  .line-parent-lines {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .line-parent-lines a + a::before {
    content: "·";
    margin: 0 0.5rem;
    color: var(--color-text-alt);
  }

  .line-parent a {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid rgba(242, 140, 40, 0.4);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .line-parent a:hover {
    color: var(--color-brand-1);
    border-color: var(--color-brand-1);
  }

  /* Composición de la línea */
  .line-composition {
    margin-top: 1.5rem;
  }

  .line-composition-title {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--color-brand-1);
  }

  .composition-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;

    margin: 0;
    padding: 0;
    list-style: none;
  }

  .composition-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;

    padding: 0.35rem 0.7rem;

    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);

    font-size: 0.7rem;
    line-height: 1.2;
    color: var(--color-text);
    text-decoration: none;

    transition: border-color 0.2s ease, color 0.2s ease;
  }

  a.composition-item:hover {
    border-color: var(--color-brand-1);
    color: var(--color-brand-1);
  }

  .composition-dot {
    width: 5px;
    height: 5px;

    border-radius: 50%;
    background: var(--color-brand-1);

    flex-shrink: 0;
  }

  .composition-note {
    font-size: 0.58rem;
    color: var(--color-text-alt);
  }

  /* Specs table */
  .specs-table {


    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .spec-row {
    display: flex;

    align-items: baseline;
    justify-content: space-between;

    gap: 1.5rem;

    padding: 0.5rem 0;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .spec-label {
    font-size: 0.75rem;

    color: var(--color-text-alt);

    flex-shrink: 0;
  }

  .spec-value {
    font-size: 0.62rem;
    line-height: 1.5;

    color: var(--color-white);

    text-align: right;

    overflow-wrap: break-word;

    min-width: 0;
  }

  /* Features */
  .features {
    display: flex;
    flex-direction: column;

    gap: 1.25rem;

    margin: 2rem 0 0;

    padding: 0;

    list-style: none;
  }

  .feature {
    display: flex;

    gap: 0.9rem;
  }

  .feature-check {
    display: grid;
    place-items: center;

    width: 1.4rem;
    height: 1.4rem;

    flex-shrink: 0;

    color: var(--color-brand-1);
  }

  .feature-check svg {
    width: 100%;
    height: 100%;
  }

  .feature-title {
    margin: 0;

    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: 700;

    color: var(--color-white);
  }

  .feature-text {
    margin: 0.25rem 0 0;

    font-size: var(--font-size-sm);
    line-height: 1.55;

    color: var(--color-text-alt);
  }

  /* Detail (expandible) */
  .detail {
    margin-top: 2rem;
  }

  .detail-text {
    margin: 0;

    font-size: var(--font-size-sm);
    line-height: 1.65;

    color: var(--color-text-alt);

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;

    transition: none;
  }

  .detail.is-open .detail-text {
    display: block;

    -webkit-line-clamp: unset;
  }

  .detail-toggle {
    display: inline-flex;

    align-items: center;

    margin-top: 0.75rem;

    padding: 0;

    border: none;
    background: none;

    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: 600;

    color: var(--color-brand-1);

    cursor: pointer;
  }

  .detail-toggle:hover {
    text-decoration: underline;
  }

  .detail .detail-toggle-less {
    display: none;
  }

  .detail.is-open .detail-toggle-less {
    display: inline;
  }

  .detail.is-open .detail-toggle-more {
    display: none;
  }

  /* Actions */
  .actions {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 1rem;

    margin-top: 1rem;
  }

  .actions :global(.btn) {
    white-space: nowrap;
  }

  .actions :global(.secondary) {
    background: transparent;
    color: var(--color-text);
    border: 1px solid rgba(0,0,0,0.15);
  }

  .actions :global(.secondary:hover) {
    border-color: var(--color-brand-1);
    color: var(--color-brand-1);
  }

  /* Media */
  .media {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Gallery */
  .gallery {
    position: relative;
  }

  .gallery-stage {
    position: relative;

    aspect-ratio: 1;

    background: rgba(0, 0, 0, 0.02);

    border: 1px solid rgba(255, 255, 255, 0.08);

    overflow: hidden;

    cursor: zoom-in;
  }

  .gallery-item {
    position: absolute;

    inset: 0;

    opacity: 0;

    transition: opacity 400ms ease;

    pointer-events: none;
  }

  .gallery-item.is-active {
    opacity: 1;
  }

  .gallery-item img,
  .gallery-item video {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }

  /* Arrows — appear on hover */
  .gallery-arrow {
    position: absolute;

    top: 50%;

    transform: translateY(-50%);

    display: grid;
    place-items: center;

    width: 2.75rem;
    height: 2.75rem;

    padding: 0;

    border: 1px solid rgba(255, 255, 255, 0.15);

    background: rgba(17, 17, 17, 0.75);

    color: var(--color-white);

    font-size: 1.4rem;
    line-height: 1;

    cursor: pointer;

    opacity: 0;

    transition: opacity 0.25s ease, background 0.2s ease, color 0.2s ease;

    z-index: 3;
  }

  .gallery-arrow.prev {
    left: 0.75rem;
  }

  .gallery-arrow.next {
    right: 0.75rem;
  }

  .gallery-arrow:hover,
  .gallery-arrow:focus-visible {
    background: var(--color-brand-1);
    color: var(--color-white);

    border-color: var(--color-brand-1);
  }

  .gallery-stage:hover .gallery-arrow,
  .gallery-stage:focus-within .gallery-arrow,
  .lightbox:hover .gallery-arrow,
  .lightbox:focus-within .gallery-arrow {
    opacity: 1;
  }

  /* Counter */
  .gallery-counter {
    position: absolute;

    right: 0.75rem;
    bottom: 0.75rem;

    display: flex;

    gap: 0.35rem;

    padding: 0.3rem 0.6rem;

    background: rgba(17, 17, 17, 0.75);

    font-size: 0.6rem;
    letter-spacing: 0.08em;

    color: var(--color-white);

    z-index: 3;

    pointer-events: none;
  }

  .gallery-counter-sep {
    opacity: 0.5;
  }

  /* Dots */
  .gallery-dots {
    position: absolute;

    left: 50%;
    bottom: 0.75rem;

    transform: translateX(-50%);

    display: flex;

    gap: 0.4rem;

    z-index: 3;
  }

  .gallery-dot {
    width: 0.5rem;
    height: 0.5rem;

    padding: 0;

    border: none;
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.35);

    cursor: pointer;

    transition: background 0.2s ease, transform 0.2s ease;
  }

  .gallery-dot.is-active {
    background: var(--color-brand-1);

    transform: scale(1.25);
  }

  /* PDF button */
  .pdf-btn {
    display: inline-flex;

    align-items: center;

    gap: 0.6rem;

    padding: 0.875em 1.5em;

    border: 1px solid rgba(255, 255, 255, 0.2);

    color: var(--color-white);

    white-space: nowrap;

    text-decoration: none;

    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;

    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .pdf-btn:hover,
  .pdf-btn:focus {
    border-color: var(--color-brand-1);
    color: var(--color-brand-1);
  }

  .pdf-icon {
    width: 1.1em;
    height: 1.1em;

    flex-shrink: 0;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;

    inset: 0;

    z-index: 100;

    background: rgba(0, 0, 0, 0.94);

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-stage {
    position: relative;

    width: 100%;
    height: 100%;

    max-width: min(92vw, 1100px);
    max-height: 92vh;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-item {
    position: absolute;

    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    opacity: 0;

    transition: opacity 300ms ease;

    pointer-events: none;
  }

  .lightbox-item.is-active {
    opacity: 1;

    pointer-events: auto;
  }

  .lightbox-item img,
  .lightbox-item video {
    max-width: 100%;
    max-height: 92vh;

    width: auto;
    height: auto;

    object-fit: contain;
  }

  /* Always visible inside the lightbox (not hover-only) */
  .lightbox .gallery-arrow,
  .lightbox-close {
    opacity: 1;
  }

  .lightbox-close {
    position: absolute;

    top: 1.25rem;
    right: 1.25rem;

    display: grid;
    place-items: center;

    width: 2.75rem;
    height: 2.75rem;

    padding: 0;

    border: 1px solid rgba(255, 255, 255, 0.2);

    background: rgba(17, 17, 17, 0.75);

    color: var(--color-white);

    font-size: 1.1rem;

    cursor: pointer;

    z-index: 4;

    transition: background 0.2s ease, color 0.2s ease;
  }

  .lightbox-close:hover {
    background: var(--color-brand-1);

    border-color: var(--color-brand-1);
  }

  /* Card CALIDAD DYFMA */
  .quality-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.1rem 1.25rem;
    background: rgba(0,0,0,0.015);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 6px;
  }

  .quality-icon {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: var(--color-brand-1);
    margin-top: 0.1rem;
  }

  .quality-text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .quality-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0;
  }

  .quality-desc {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-alt);
    margin: 0;
  }

  /* Back link */
  .back-link {
    display: inline-block;
    margin-top: 4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-alt);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-brand-1);
  }

  /* Responsive */
  @media (--mq-tablet) {
    .inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .media {
      position: static;
      order: -1;
    }

    .machine-title {
      font-size: 2rem;
    }

    .section-subtitle,
    .spec-subtitle {
      font-size: 1.15rem;
    }
  }

  @media (--mq-phone) {
    .machine-page {
      padding: 6rem 0 3rem;
    }

    .actions {
      flex-direction: column;
    }

    .section-subtitle,
    .spec-subtitle {
      font-size: 1.1rem;
    }
  }
  .lightbox.is-idle .gallery-arrow,
  .lightbox.is-idle .lightbox-close,
  .lightbox.is-idle .gallery-counter {
    opacity: 0;

    pointer-events: none;
  }

  .lightbox-close,
  .lightbox .gallery-arrow,
  .lightbox .gallery-counter {
    transition: opacity 0.3s ease, background 0.2s ease, color 0.2s ease;
  }
</style>

<script>
  function initGallery() {
    const gallery = document.querySelector<HTMLElement>("[data-gallery]");
    const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
    if (!gallery || !lightbox) return;

    const stageItems = Array.from(gallery.querySelectorAll<HTMLElement>(".gallery-item"));
    const lightItems = Array.from(lightbox.querySelectorAll<HTMLElement>(".lightbox-item"));
    const dots = Array.from(gallery.querySelectorAll<HTMLElement>("[data-gallery-dot]"));
    const stageCounter = gallery.querySelector<HTMLElement>("[data-gallery-current]");
    const lightCounter = lightbox.querySelector<HTMLElement>("[data-lightbox-current]");
    const total = stageItems.length;

    let index = 0;

    const pad = (n: number) => String(n + 1).padStart(2, "0");

    function setActive(item: HTMLElement, i: number) {
      const media = item.querySelector("video, img") as HTMLVideoElement | HTMLImageElement;
      if (media && media.tagName === "VIDEO") media.play().catch(() => {});
    }

    function pauseItem(item: HTMLElement) {
      const media = item.querySelector("video") as HTMLVideoElement | null;
      if (media) {
        media.pause();
        media.currentTime = 0;
      }
    }

    function show(i: number) {
      index = (i + total) % total;

      stageItems.forEach((item, j) => {
        const active = j === index;
        item.classList.toggle("is-active", active);
        if (active) setActive(item, j);
        else pauseItem(item);
      });

      lightItems.forEach((item, j) => {
        const active = j === index;
        item.classList.toggle("is-active", active);
        if (active) setActive(item, j);
        else if (!lightbox.hidden) pauseItem(item);
      });

      dots.forEach((dot, j) => dot.classList.toggle("is-active", j === index));

      if (stageCounter) stageCounter.textContent = pad(index);
      if (lightCounter) lightCounter.textContent = pad(index);
    }

    const next = () => show(index + 1);
    const prev = () => show(index - 1);

    gallery.querySelectorAll("[data-gallery-next]").forEach((el) => el.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); next(); }));
    gallery.querySelectorAll("[data-gallery-prev]").forEach((el) => el.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); prev(); }));
    dots.forEach((dot) => dot.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); show(Number((dot as HTMLElement).dataset.galleryDot)); }));

    // Lightbox
    function openLightbox() {
      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
      wake();
      show(index);
    }

    function closeLightbox() {
      lightbox.hidden = true;
      document.body.style.overflow = "";
      lightItems.forEach(pauseItem);
      show(index);
    }

    gallery.querySelector("[data-gallery-open]")?.addEventListener("click", openLightbox);
    lightbox.querySelector("[data-lightbox-close]")?.addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    lightbox.querySelector("[data-lightbox-next]")?.addEventListener("click", next);
    lightbox.querySelector("[data-lightbox-prev]")?.addEventListener("click", prev);

    document.addEventListener("keydown", (e) => {
      if (!lightbox.hidden) {
        if (e.key === "Escape") closeLightbox();
        if (e.key === "ArrowRight") next();
        if (e.key === "ArrowLeft") prev();
        return;
      }
      const rect = gallery.getBoundingClientRect();
      const inView = rect.top < window.innerHeight && rect.bottom > 0;
      if (inView) {
        if (e.key === "ArrowRight") next();
        if (e.key === "ArrowLeft") prev();
      }
    });

    // Auto-hide controls when mouse is idle
    let idleTimer: ReturnType<typeof setTimeout>;

    function wake() {
      lightbox.classList.remove("is-idle");
      clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        if (!lightbox.hidden) lightbox.classList.add("is-idle");
      }, 2500);
    }

    lightbox.addEventListener("mousemove", wake);
    lightbox.addEventListener("touchstart", wake, { passive: true });
    lightbox.addEventListener("mouseleave", () => {
      clearTimeout(idleTimer);
      lightbox.classList.add("is-idle");
    });


    // Swipe (touch)
    let startX = 0;
    let tracking = false;

    function bindSwipe(el: HTMLElement) {
      el.addEventListener("touchstart", (e) => {
        startX = e.touches[0].clientX;
        tracking = true;
      }, { passive: true });
      el.addEventListener("touchend", (e) => {
        if (!tracking) return;
        tracking = false;
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) (dx < 0 ? next : prev)();
      }, { passive: true });
    }

    bindSwipe(gallery.querySelector<HTMLElement>(".gallery-stage")!);
    if (total > 1) bindSwipe(lightbox);

    // Autoplay first item if video
    show(0);
  }

  initGallery();

  // Detail expand/collapse
  const detail = document.querySelector("[data-detail]");
  if (detail) {
    const toggle = detail.querySelector("[data-detail-toggle]");
    toggle?.addEventListener("click", () => {
      const open = detail.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
    });
  }
</script>
