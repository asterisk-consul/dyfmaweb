---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import { machines, categoryLabels } from "../../data/machines";
import type { MachineCategory } from "../../data/machines";

// Group machines by category (modules are shown inside their line, not as cards)
const grouped = machines
  .filter((m) => m.role !== "module")
  .reduce((acc, m) => {
    if (!acc[m.category]) acc[m.category] = [];
    acc[m.category].push(m);
    return acc;
  }, {} as Record<MachineCategory, typeof machines>);

// Lines first inside each group
Object.values(grouped).forEach((list) => {
  list.sort((a, b) => (a.role === "line" ? 0 : 1) - (b.role === "line" ? 0 : 1));
});

const categories: MachineCategory[] = [
  "cosecha",
  "poscosecha",
  "pelado-partido",
  "post-pelado",
];
---

<Layout title="Máquinas — DYFMA">
  <div class="machines-page">
    <div class="u-container container">
      <!-- Hero -->
      <div class="hero">
        <span class="section-tag u-spec">Maquinaria</span>
        <h1 class="page-title">Nuestras máquinas</h1>
        <p class="page-desc">
          Equipos diseñados y fabricados en Villa María, Córdoba, para la industria de frutos secos.
        </p>
      </div>

      <!-- Categories -->
      <div class="categories">
        {categories.map((cat) => (
          grouped[cat] && (
            <section class="category-section">
              <h2 class="category-title">{categoryLabels[cat]}</h2>
              <div class="machines-grid">
                {grouped[cat].map((machine) => (
                  <a
                    href={`/dyfmaweb/maquinas/${machine.id}`}
                    class:list={["machine-card", machine.role === "line" && "machine-card--line"]}
                  >
                    <div class="card-media" data-has-video={machine.video ? "" : undefined}>
                      {machine.image ? (
                        <img
                          src={machine.image}
                          alt={machine.name}
                          width="600"
                          height="450"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : machine.video ? (
                        <video
                          class="hover-video"
                          src={machine.video}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        ></video>
                      ) : (
                        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <rect x="10" y="10" width="80" height="80" rx="4" stroke="#D4D4D4" stroke-width="1" stroke-dasharray="4 4"/>
                          <path d="M50 35 L65 55 L35 55 Z" stroke="#F28C28" stroke-width="1.5" fill="none"/>
                          <circle cx="50" cy="45" r="3" fill="#F28C28"/>
                        </svg>
                      )}
                      {machine.video && machine.image ? (
                        <video
                          class="hover-video"
                          src={machine.video}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        ></video>
                      ) : null}
                      {machine.video ? <span class="media-badge u-mono">VIDEO</span> : null}
                      {machine.role === "line" ? <span class="line-badge u-mono">LÍNEA</span> : null}
                    </div>

                    <div class="card-content">
                      <span class="card-name">{machine.name}</span>
                      <span class="card-name-en u-mono">{machine.nameEn}</span>
                      {machine.role === "line" ? (
                        <span class="card-line-note u-mono">Compuesta por módulos</span>
                      ) : (
                        <span class="card-spec u-mono">
                          {machine.specs.slice(0, 2).map(s => s.value).join(" — ")}
                        </span>
                      )}
                    </div>
                    <span class="card-arrow">→</span>
                  </a>
                ))}
              </div>
            </section>
          )
        ))}
      </div>

      <!-- CTA -->
      <section class="cta-section">
        <h2 class="cta-title">¿Necesitás una solución a medida?</h2>
        <p class="cta-desc">Desarrollamos equipos personalizados según las necesidades de cada cliente.</p>
        <Button title="Solicitar cotización" url="/dyfmaweb/contacto" arrow />
      </section>
    </div>
  </div>
</Layout>

<style>
  .machines-page {
    padding: 8rem 0 4rem;
    min-height: 100vh;
    background: var(--color-bg);
  }

  .container {
    max-width: 1100px;
  }

  /* Hero */
  .hero {
    margin-bottom: 4rem;
  }

  .section-tag {
    color: var(--color-brand-1);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-text);
    margin: 1rem 0;
  }

  .page-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-alt);
    line-height: 1.6;
    max-width: 30em;
  }

  /* Categories */
  .categories {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .category-section {
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .category-section:last-child {
    border-bottom: none;
  }

  .category-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-1);
    margin: 0 0 1.5rem;
  }

  .machines-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .machine-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .machine-card:hover {
    border-color: var(--color-brand-1);
    background: rgba(242, 140, 40, 0.02);
    transform: translateY(-2px);
  }

  /* Line cards — mismo tamaño que el resto, con acento sutil */
  .machine-card--line {
    border-color: rgba(242, 140, 40, 0.35);
    background: rgba(242, 140, 40, 0.03);
  }

  .machine-card--line:hover {
    border-color: var(--color-brand-1);
    background: rgba(242, 140, 40, 0.05);
  }

  .line-badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.28rem 0.55rem;
    background: var(--color-brand-1);
    color: #fff;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    pointer-events: none;
  }

  .card-line-note {
    font-size: 0.6rem;
    line-height: 1.6;
    color: var(--color-brand-1);
    opacity: 0.9;
    min-height: calc(3 * 1.6em);
  }

  /* Media */
  .card-media {
    position: relative;

    width: 100%;

    aspect-ratio: 4 / 3;

    overflow: hidden;

    background: rgba(0, 0, 0, 0.02);
  }

  .card-media img,
  .card-media video,
  .card-media svg {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transition: transform 0.4s var(--ease-out-cubic);
  }

  .card-media svg {
    object-fit: contain;

    padding: 2rem;
  }

  .machine-card:hover .card-media img,
  .machine-card:hover .card-media video {
    transform: scale(1.04);
  }

  /* Hover video preview — layered above the image, fades in on hover */
  .card-media .hover-video {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    opacity: 0;

    transition: opacity 0.3s ease, transform 0.4s var(--ease-out-cubic);

    pointer-events: none;
  }

  .machine-card:hover .hover-video,
  .machine-card:focus-visible .hover-video {
    opacity: 1;
  }

  .media-badge {
    position: absolute;

    top: 0.6rem;
    left: 0.6rem;

    padding: 0.3rem 0.6rem;

    background: rgba(17, 17, 17, 0.85);

    font-size: 0.55rem;
    letter-spacing: 0.1em;

    color: var(--color-brand-1);

    pointer-events: none;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;

    padding: 1.1rem 1.25rem 1.25rem;

    min-width: 0;
  }

  .card-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-brand-1);

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(2 * 1.15em);
  }

  .card-name-en {
    font-size: 0.65rem;
    color: var(--color-text-alt);

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-spec {
    font-size: 0.6rem;
    line-height: 1.6;
    color: var(--color-text-alt);
    opacity: 0.7;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(3 * 1.6em);
  }

  .card-arrow {
    position: absolute;

    right: 1rem;
    bottom: 1.1rem;

    color: var(--color-text-alt);
    font-size: 1.2rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .machine-card:hover .card-arrow {
    color: var(--color-brand-1);
    transform: translateX(4px);
  }

  /* CTA */
  .cta-section {
    margin-top: 4rem;
    text-align: center;
    padding: 4rem 0;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .cta-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .cta-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-alt);
    margin-bottom: 2rem;
  }

  /* Responsive */
  @media (--mq-tablet) {
    .machines-grid {
      grid-template-columns: 1fr;
    }

    .page-title {
      font-size: 2rem;
    }
  }

  @media (--mq-phone) {
    .machines-page {
      padding: 6rem 0 3rem;
    }
  }
</style>

<script>
  // Hover video preview: plays the card video on hover, pauses + resets on leave.
  // Videos only load when first hovered (preload="metadata"), so the listing stays light.
  function initHoverPreviews() {
    document
      .querySelectorAll<HTMLElement>(
        ".machine-card[data-has-video], .machine-card:has(.hover-video)"
      )
      .forEach((card) => {
        const video = card.querySelector("video.hover-video");
        if (!video || card.dataset.previewBound) return;
        card.dataset.previewBound = "true";

        const start = () => {
          video.play().catch(() => {});
        };
        const stop = () => {
          video.pause();
          video.currentTime = 0;
        };

        card.addEventListener("mouseenter", start);
        card.addEventListener("focusin", start);
        card.addEventListener("mouseleave", stop);
        card.addEventListener("focusout", stop);
      });
  }

  initHoverPreviews();
</script>
