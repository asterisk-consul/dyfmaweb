---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import { machines, categoryLabels } from "../../data/machines";
import type { MachineCategory } from "../../data/machines";

// Group machines by category
const grouped = machines.reduce((acc, m) => {
  if (!acc[m.category]) acc[m.category] = [];
  acc[m.category].push(m);
  return acc;
}, {} as Record<MachineCategory, typeof machines>);

const categories: MachineCategory[] = ["cosecha", "partido", "limpieza", "lineas", "envasado"];
---

<Layout title="Máquinas — DYFMA">
  <div class="machines-page">
    <div class="u-container container">
      <!-- Hero -->
      <div class="hero">
        <span class="section-tag u-spec">Maquinaria</span>
        <h1 class="page-title">Nuestras máquinas</h1>
        <p class="page-desc">
          Equipos diseñados y fabricados en Villa María, Córdoba, para la industria de frutos secos.
        </p>
      </div>

      <!-- Categories -->
      <div class="categories">
        {categories.map((cat) => (
          grouped[cat] && (
            <section class="category-section">
              <h2 class="category-title">{categoryLabels[cat]}</h2>
              <div class="machines-grid">
                {grouped[cat].map((machine) => (
                  <a href={`/dyfmaweb/maquinas/${machine.id}`} class="machine-card">
                    <div class="card-image">
                      <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="10" y="10" width="80" height="80" rx="4" stroke="#D4D4D4" stroke-width="1" stroke-dasharray="4 4"/>
                        <path d="M50 35 L65 55 L35 55 Z" stroke="#F47C2C" stroke-width="1.5" fill="none"/>
                        <circle cx="50" cy="45" r="3" fill="#F47C2C"/>
                      </svg>
                    </div>
                    <div class="card-content">
                      <span class="card-name">{machine.name}</span>
                      <span class="card-name-en u-mono">{machine.nameEn}</span>
                      <span class="card-spec u-mono">
                        {machine.specs.map(s => s.value).join(" — ")}
                      </span>
                    </div>
                    <span class="card-arrow">→</span>
                  </a>
                ))}
              </div>
            </section>
          )
        ))}
      </div>

      <!-- CTA -->
      <section class="cta-section">
        <h2 class="cta-title">¿Necesitás una solución a medida?</h2>
        <p class="cta-desc">Desarrollamos equipos personalizados según las necesidades de cada cliente.</p>
        <Button title="Solicitar cotización" url="/dyfmaweb/contacto" arrow />
      </section>
    </div>
  </div>
</Layout>

<style>
  .machines-page {
    padding: 8rem 0 4rem;
    min-height: 100vh;
    background: var(--color-bg);
  }

  .container {
    max-width: 1100px;
  }

  /* Hero */
  .hero {
    margin-bottom: 4rem;
  }

  .section-tag {
    color: var(--color-brand-1);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-text);
    margin: 1rem 0;
  }

  .page-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-alt);
    line-height: 1.6;
    max-width: 30em;
  }

  /* Categories */
  .categories {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .category-section {
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  .category-section:last-child {
    border-bottom: none;
  }

  .category-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-1);
    margin: 0 0 1.5rem;
  }

  .machines-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .machine-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: rgba(0,0,0,0.02);
    border: 1px solid rgba(0,0,0,0.06);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .machine-card:hover {
    border-color: var(--color-brand-1);
    background: rgba(244, 124, 44, 0.02);
  }

  .card-image {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-image svg {
    width: 100%;
    height: 100%;
  }

  .card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .card-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .card-name-en {
    font-size: 0.65rem;
    color: var(--color-text-alt);
  }

  .card-spec {
    font-size: 0.6rem;
    color: var(--color-text-alt);
    opacity: 0.7;
  }

  .card-arrow {
    color: var(--color-text-alt);
    font-size: 1.2rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .machine-card:hover .card-arrow {
    color: var(--color-brand-1);
    transform: translateX(4px);
  }

  /* CTA */
  .cta-section {
    margin-top: 4rem;
    text-align: center;
    padding: 4rem 0;
    border-top: 1px solid rgba(0,0,0,0.08);
  }

  .cta-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .cta-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-alt);
    margin-bottom: 2rem;
  }

  /* Responsive */
  @media (--mq-tablet) {
    .machines-grid {
      grid-template-columns: 1fr;
    }

    .page-title {
      font-size: 2rem;
    }
  }

  @media (--mq-phone) {
    .machines-page {
      padding: 6rem 0 3rem;
    }
  }
</style>
