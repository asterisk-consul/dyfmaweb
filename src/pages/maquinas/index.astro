---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import { machines, categoryLabels } from "../../data/machines";
import type { MachineCategory } from "../../data/machines";

// Group machines by category (modules are shown inside their line, not as cards)
const grouped = machines
  .filter((m) => m.role !== "module")
  .reduce((acc, m) => {
    if (!acc[m.category]) acc[m.category] = [];
    acc[m.category].push(m);
    return acc;
  }, {} as Record<MachineCategory, typeof machines>);

// Lines first inside each group
Object.values(grouped).forEach((list) => {
  list.sort((a, b) => (a.role === "line" ? 0 : 1) - (b.role === "line" ? 0 : 1));
});

const categories: MachineCategory[] = [
  "cosecha",
  "poscosecha",
  "pelado-partido",
  "post-pelado",
];

const integrationModules = ["partidora-pecan-avellana", "elevador-dosificador"]
  .map((id) => machines.find((machine) => machine.id === id))
  .filter((machine) => machine !== undefined);

const fruitFilters = [
  { id: "pecan", label: "Nuez pecán" },
  { id: "chandler", label: "Nuez Chandler" },
  { id: "almendra", label: "Almendra" },
  { id: "avellana", label: "Avellana" },
  { id: "pistacho", label: "Pistacho" },
];

const needFilters = [
  { id: "cosecha", label: "Cosechar" },
  { id: "limpieza", label: "Limpiar" },
  { id: "secado", label: "Secar" },
  { id: "partido", label: "Partir" },
  { id: "pelado", label: "Pelar" },
  { id: "envasado", label: "Envasar" },
  { id: "linea", label: "Línea completa" },
];

const machineFilters: Record<string, { fruits: string[]; needs: string[] }> = {
  "remecedor-linga": { fruits: ["pecan", "chandler"], needs: ["cosecha"] },
  recolector: { fruits: ["pecan", "chandler"], needs: ["cosecha"] },
  "partidora-pecan-avellana": { fruits: ["pecan", "avellana"], needs: ["partido"] },
  "limpiadora-campo": { fruits: ["pecan"], needs: ["limpieza"] },
  "horno-deshidratador": { fruits: ["pecan", "chandler", "almendra", "avellana", "pistacho"], needs: ["secado"] },
  despelonadora: { fruits: ["almendra"], needs: ["pelado"] },
  "despelonadora-nuez-chandler": { fruits: ["chandler"], needs: ["pelado"] },
  "linea-limpieza": { fruits: ["pecan", "chandler", "almendra", "avellana", "pistacho"], needs: ["limpieza", "linea"] },
  "linea-secado": { fruits: ["pecan", "chandler", "almendra", "avellana", "pistacho"], needs: ["secado", "linea"] },
  "linea-semi-industrial": { fruits: ["pecan"], needs: ["partido", "linea"] },
  "linea-pelado": { fruits: ["pecan"], needs: ["pelado", "partido", "linea"] },
  envasadora: { fruits: ["pecan", "chandler", "almendra", "avellana"], needs: ["envasado"] },
};
---

<Layout
  title="Máquinas para frutos secos | DYFMA"
  description="Explorá máquinas y líneas DYFMA para cosecha, limpieza, secado, pelado, partido y envasado de frutos secos."
>
  <div class="machines-page">
    <div class="u-container container">
      <!-- Hero -->
      <div class="hero">
        <span class="section-tag u-spec">Maquinaria</span>
        <h1 class="page-title">Nuestras máquinas</h1>
        <p class="page-desc">
          Equipos diseñados y fabricados en Villa María, Córdoba, para la industria de frutos secos.
        </p>
      </div>

      <section class="solution-finder" aria-labelledby="solution-finder-title">
        <div class="finder-heading">
          <div>
            <span class="section-tag u-spec">Encontrá tu solución</span>
            <h2 id="solution-finder-title" class="finder-title">¿Qué necesitás resolver?</h2>
            <p class="finder-desc">Elegí el fruto y la etapa de tu proceso. Te mostramos los equipos que pueden ayudarte.</p>
          </div>
          <button class="clear-filters" type="button" hidden>Limpiar filtros</button>
        </div>

        <div class="filter-groups">
          <fieldset class="filter-group">
            <legend>¿Qué fruto procesás?</legend>
            <div class="filter-options">
              {fruitFilters.map((filter) => (
                <button class="filter-chip" type="button" data-filter-group="fruit" data-filter-value={filter.id} aria-pressed="false">
                  {filter.label}
                </button>
              ))}
            </div>
          </fieldset>

          <fieldset class="filter-group">
            <legend>¿En qué etapa necesitás ayuda?</legend>
            <div class="filter-options">
              {needFilters.map((filter) => (
                <button class="filter-chip" type="button" data-filter-group="need" data-filter-value={filter.id} aria-pressed="false">
                  {filter.label}
                </button>
              ))}
            </div>
          </fieldset>
        </div>

        <p class="filter-summary" aria-live="polite">Mostrando todas las soluciones.</p>
        <p class="pistachio-note" hidden>
          Para pistacho mostramos equipos de uso general. La configuración final se define según tu producto y volumen.
        </p>
      </section>

      <!-- Categories -->
      <div class="categories">
        {categories.map((cat) => (
          grouped[cat] && (
            <section class="category-section" data-category={cat}>
              <h2 class="category-title">{categoryLabels[cat]}</h2>
              <div class="machines-grid">
                {grouped[cat].map((machine) => (
                  <a
                    href={`/maquinas/${machine.id}`}
                    class:list={["machine-card", machine.role === "line" && "machine-card--line"]}
                    data-fruits={(machineFilters[machine.id]?.fruits ?? []).join(" ")}
                    data-needs={(machineFilters[machine.id]?.needs ?? []).join(" ")}
                  >
                    <div class="card-media" data-has-video={machine.video ? "" : undefined}>
                      {machine.image ? (
                        <img
                          src={machine.image}
                          alt={machine.name}
                          width="600"
                          height="450"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : machine.video ? (
                        <video
                          class="hover-video"
                          src={machine.video}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        ></video>
                      ) : (
                        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <rect x="10" y="10" width="80" height="80" rx="4" stroke="#D4D4D4" stroke-width="1" stroke-dasharray="4 4"/>
                          <path d="M50 35 L65 55 L35 55 Z" stroke="#F28C28" stroke-width="1.5" fill="none"/>
                          <circle cx="50" cy="45" r="3" fill="#F28C28"/>
                        </svg>
                      )}
                      {machine.video && machine.image ? (
                        <video
                          class="hover-video"
                          src={machine.video}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                        ></video>
                      ) : null}
                      {machine.video ? <span class="media-badge u-mono">VIDEO</span> : null}
                      {machine.role === "line" ? <span class="line-badge u-mono">LÍNEA</span> : null}
                    </div>

                    <div class="card-content">
                      <span class="card-name">{machine.name}</span>
                      <span class="card-name-en u-mono">{machine.nameEn}</span>
                      {machine.role === "line" ? (
                        <span class="card-line-note u-mono">Compuesta por módulos</span>
                      ) : (
                        <span class="card-spec u-mono">
                          {machine.specs.slice(0, 2).map(s => s.value).join(" — ")}
                        </span>
                      )}
                    </div>
                    <span class="card-arrow">→</span>
                  </a>
                ))}
              </div>
            </section>
          )
        ))}
      </div>

      <section class="modules-section">
        <div class="modules-head">
          <div>
            <span class="section-tag u-spec">INTEGRACIÓN MODULAR</span>
            <h2 class="modules-title">Módulos para completar tu línea</h2>
            <p class="modules-desc">Sumá etapas y conectá equipos a medida que crece tu producción, sin reemplazar toda la instalación.</p>
          </div>
          <a class="modules-contact" href="/contacto">Consultar integración →</a>
        </div>

        <div class="modules-grid">
          {integrationModules.map((machine) => (
            <a class="module-card" href={`/maquinas/${machine.id}`}>
              <div class="module-media">
                {machine.image && <img src={machine.image} alt={machine.name} width="480" height="360" loading="lazy" />}
                <span class="module-badge u-mono">MÓDULO</span>
              </div>
              <div class="module-copy">
                <span class="module-name">{machine.name}</span>
                <p>{machine.description}</p>
                <span class="module-link">Ver módulo →</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="no-results" hidden>
        <h2>No encontramos una máquina estándar para esa combinación.</h2>
        <p>Contanos qué producís, qué volumen manejás y cómo trabajás hoy. Podemos analizar una configuración a medida.</p>
        <Button title="Quiero asesorarme" url="/contacto" arrow revealable={false} />
      </section>

      <!-- CTA -->
      <section class="cta-section">
        <h2 class="cta-title">¿Necesitás una solución a medida?</h2>
        <p class="cta-desc">Desarrollamos equipos personalizados según las necesidades de cada cliente.</p>
        <Button title="Solicitar cotización" url="/contacto" arrow />
      </section>
    </div>
  </div>
</Layout>

<style>
  .machines-page {
    padding: 8rem 0 4rem;
    min-height: 100vh;
    background: var(--color-bg);
  }

  .container {
    max-width: 1100px;
  }

  /* Hero */
  .hero {
    margin-bottom: 4rem;
  }

  .section-tag {
    color: var(--color-brand-1);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-text);
    margin: 1rem 0;
  }

  .page-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-alt);
    line-height: 1.6;
    max-width: 30em;
  }

  /* Categories */
  .machine-card[hidden],
  .category-section[hidden],
  .no-results[hidden],
  .pistachio-note[hidden],
  .clear-filters[hidden] {
    display: none !important;
  }

  .solution-finder {
    margin-bottom: 2.25rem;
    padding: clamp(1.1rem, 2.5vw, 1.6rem);
    border: 1px solid rgba(242, 140, 40, 0.3);
    background: rgba(242, 140, 40, 0.035);
  }

  .finder-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 1.15rem;
  }

  .finder-title {
    margin: 0.4rem 0 0.35rem;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    font-weight: 500;
  }

  .finder-desc {
    max-width: 42rem;
    margin: 0;
    color: var(--color-text-alt);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .filter-groups {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .filter-group {
    margin: 0;
    padding: 0.9rem 0 0.25rem;
    border: 0;
  }

  .filter-group legend {
    padding: 0 0 0.55rem;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-chip,
  .clear-filters {
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: transparent;
    color: var(--color-text-alt);
    font: inherit;
    transition: 0.2s ease;
    transition-property: color, border-color, background;
  }

  .filter-chip {
    padding: 0.48rem 0.72rem;
    font-size: 0.75rem;
  }

  .filter-chip:hover,
  .filter-chip:focus-visible,
  .filter-chip[aria-pressed="true"] {
    border-color: var(--color-brand-1);
    background: var(--color-brand-1);
    color: #fff;
  }

  .clear-filters {
    flex: 0 0 auto;
    padding: 0.55rem 0.8rem;
    font-size: 0.7rem;
  }

  .clear-filters:hover,
  .clear-filters:focus-visible {
    border-color: var(--color-brand-1);
    color: var(--color-brand-1);
  }

  .filter-summary,
  .pistachio-note {
    margin: 0.8rem 0 0;
    color: var(--color-text-alt);
    font-size: 0.85rem;
  }

  .pistachio-note {
    padding-left: 0.85rem;
    border-left: 2px solid var(--color-brand-1);
  }

  .categories {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    scroll-margin-top: 6rem;
  }

  .category-section {
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .category-section:last-child {
    border-bottom: none;
  }

  .no-results {
    margin: 1rem 0 4rem;
    padding: 3rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    scroll-margin-top: 6rem;
  }

  .no-results h2 {
    margin: 0 0 0.75rem;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 500;
  }

  .no-results p {
    max-width: 42rem;
    margin: 0 auto 1.5rem;
    color: var(--color-text-alt);
    line-height: 1.6;
  }

  .modules-section {
    margin-top: 4.5rem;
    padding: 3rem 0 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .modules-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .modules-title {
    margin: 0.65rem 0 0.5rem;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
  }

  .modules-desc {
    max-width: 42rem;
    margin: 0;
    color: var(--color-text-alt);
    line-height: 1.55;
  }

  .modules-contact {
    flex: 0 0 auto;
    color: var(--color-brand-1);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .module-card {
    display: grid;
    grid-template-columns: minmax(9rem, 0.7fr) minmax(0, 1.3fr);
    min-width: 0;
    border: 1px solid rgba(242, 140, 40, 0.28);
    background: rgba(242, 140, 40, 0.025);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .module-card:hover {
    border-color: var(--color-brand-1);
    transform: translateY(-2px);
  }

  .module-media {
    position: relative;
    min-height: 12rem;
    overflow: hidden;
    background: #fff;
  }

  .module-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .module-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    padding: 0.3rem 0.5rem;
    background: var(--color-brand-1);
    color: #fff;
    font-size: 0.52rem;
    letter-spacing: 0.1em;
  }

  .module-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.3rem;
  }

  .module-name {
    color: var(--color-brand-1);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .module-copy p {
    display: -webkit-box;
    margin: 0.65rem 0 1rem;
    overflow: hidden;
    color: var(--color-text-alt);
    font-size: 0.78rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .module-link {
    margin-top: auto;
    color: var(--color-brand-1);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .category-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-1);
    margin: 0 0 1.5rem;
  }

  .machines-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .machine-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .machine-card:hover {
    border-color: var(--color-brand-1);
    background: rgba(242, 140, 40, 0.02);
    transform: translateY(-2px);
  }

  /* Line cards — mismo tamaño que el resto, con acento sutil */
  .machine-card--line {
    border-color: rgba(242, 140, 40, 0.35);
    background: rgba(242, 140, 40, 0.03);
  }

  .machine-card--line:hover {
    border-color: var(--color-brand-1);
    background: rgba(242, 140, 40, 0.05);
  }

  .line-badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.28rem 0.55rem;
    background: var(--color-brand-1);
    color: #fff;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    pointer-events: none;
  }

  .card-line-note {
    font-size: 0.6rem;
    line-height: 1.6;
    color: var(--color-brand-1);
    opacity: 0.9;
    min-height: calc(3 * 1.6em);
  }

  /* Media */
  .card-media {
    position: relative;

    width: 100%;

    aspect-ratio: 4 / 3;

    overflow: hidden;

    background: #fff;
  }

  .card-media img,
  .card-media video,
  .card-media svg {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transition: transform 0.4s var(--ease-out-cubic);
  }

  .card-media svg {
    object-fit: contain;

    padding: 2rem;
  }

  .machine-card:hover .card-media img,
  .machine-card:hover .card-media video {
    transform: scale(1.04);
  }

  /* Hover video preview — layered above the image, fades in on hover */
  .card-media .hover-video {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    opacity: 0;

    transition: opacity 0.3s ease, transform 0.4s var(--ease-out-cubic);

    pointer-events: none;
  }

  .machine-card:hover .hover-video,
  .machine-card:focus-visible .hover-video {
    opacity: 1;
  }

  .media-badge {
    position: absolute;

    top: 0.6rem;
    left: 0.6rem;

    padding: 0.3rem 0.6rem;

    background: rgba(17, 17, 17, 0.85);

    font-size: 0.55rem;
    letter-spacing: 0.1em;

    color: var(--color-brand-1);

    pointer-events: none;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;

    padding: 1.1rem 1.25rem 1.25rem;

    min-width: 0;
  }

  .card-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-brand-1);

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(2 * 1.15em);
  }

  .card-name-en {
    font-size: 0.65rem;
    color: var(--color-text-alt);

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-spec {
    font-size: 0.6rem;
    line-height: 1.6;
    color: var(--color-text-alt);
    opacity: 0.7;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(3 * 1.6em);
  }

  .card-arrow {
    position: absolute;

    right: 1rem;
    bottom: 1.1rem;

    color: var(--color-text-alt);
    font-size: 1.2rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .machine-card:hover .card-arrow {
    color: var(--color-brand-1);
    transform: translateX(4px);
  }

  /* CTA */
  .cta-section {
    margin-top: 4rem;
    text-align: center;
    padding: 4rem 0;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .cta-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .cta-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-alt);
    margin-bottom: 2rem;
  }

  /* Responsive */
  @media (--mq-tablet) {
    .finder-heading {
      flex-direction: column;
      gap: 1rem;
    }

    .filter-groups {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .filter-group + .filter-group {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .machines-grid {
      grid-template-columns: 1fr;
    }

    .modules-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .modules-grid {
      grid-template-columns: 1fr;
    }

    .page-title {
      font-size: 2rem;
    }
  }

  @media (--mq-phone) {
    .machines-page {
      padding: 6rem 0 3rem;
    }

    .module-card {
      grid-template-columns: 1fr;
    }

    .module-media {
      min-height: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  function initMachineFilters() {
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-chip"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".machine-card"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>(".category-section"));
    const clearButton = document.querySelector<HTMLButtonElement>(".clear-filters");
    const summary = document.querySelector<HTMLElement>(".filter-summary");
    const noResults = document.querySelector<HTMLElement>(".no-results");
    const pistachioNote = document.querySelector<HTMLElement>(".pistachio-note");
    const results = document.querySelector<HTMLElement>(".categories");
    if (!chips.length || !clearButton || !summary || !noResults || !pistachioNote || !results) return;

    let selectedFruit = "";
    let selectedNeed = "";

    const applyFilters = () => {
      let visibleCount = 0;
      cards.forEach((card) => {
        const fruits = card.dataset.fruits?.split(" ").filter(Boolean) ?? [];
        const needs = card.dataset.needs?.split(" ").filter(Boolean) ?? [];
        const visible = (!selectedFruit || fruits.includes(selectedFruit)) && (!selectedNeed || needs.includes(selectedNeed));
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      sections.forEach((section) => {
        section.hidden = !section.querySelector(".machine-card:not([hidden])");
      });

      const hasFilters = Boolean(selectedFruit || selectedNeed);
      clearButton.hidden = !hasFilters;
      noResults.hidden = visibleCount !== 0;
      pistachioNote.hidden = selectedFruit !== "pistacho";
      summary.textContent = hasFilters
        ? `${visibleCount} ${visibleCount === 1 ? "solución encontrada" : "soluciones encontradas"}.`
        : "Mostrando todas las soluciones.";
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const group = chip.dataset.filterGroup;
        const value = chip.dataset.filterValue ?? "";
        const isActive = chip.getAttribute("aria-pressed") === "true";
        chips.filter((item) => item.dataset.filterGroup === group).forEach((item) => item.setAttribute("aria-pressed", "false"));
        chip.setAttribute("aria-pressed", String(!isActive));
        if (group === "fruit") selectedFruit = isActive ? "" : value;
        if (group === "need") selectedNeed = isActive ? "" : value;
        applyFilters();

        const destination = noResults.hidden ? results : noResults;
        window.setTimeout(() => {
          if (window.smoothScrollTo) window.smoothScrollTo(destination);
          else destination.scrollIntoView({ behavior: "smooth", block: "start" });
        }, 80);
      });
    });

    clearButton.addEventListener("click", () => {
      selectedFruit = "";
      selectedNeed = "";
      chips.forEach((chip) => chip.setAttribute("aria-pressed", "false"));
      applyFilters();
    });

    const params = new URLSearchParams(window.location.search);
    const initialFruit = params.get("fruto") ?? "";
    const initialNeed = params.get("necesidad") ?? "";
    const initialFruitChip = chips.find((chip) => chip.dataset.filterGroup === "fruit" && chip.dataset.filterValue === initialFruit);
    const initialNeedChip = chips.find((chip) => chip.dataset.filterGroup === "need" && chip.dataset.filterValue === initialNeed);
    if (initialFruitChip) {
      selectedFruit = initialFruit;
      initialFruitChip.setAttribute("aria-pressed", "true");
    }
    if (initialNeedChip) {
      selectedNeed = initialNeed;
      initialNeedChip.setAttribute("aria-pressed", "true");
    }
    applyFilters();
  }

  // Hover video preview: plays the card video on hover, pauses + resets on leave.
  // Videos only load when first hovered (preload="metadata"), so the listing stays light.
  function initHoverPreviews() {
    document
      .querySelectorAll<HTMLElement>(
        ".machine-card[data-has-video], .machine-card:has(.hover-video)"
      )
      .forEach((card) => {
        const video = card.querySelector("video.hover-video");
        if (!video || card.dataset.previewBound) return;
        card.dataset.previewBound = "true";

        const start = () => {
          video.play().catch(() => {});
        };
        const stop = () => {
          video.pause();
          video.currentTime = 0;
        };

        card.addEventListener("mouseenter", start);
        card.addEventListener("focusin", start);
        card.addEventListener("mouseleave", stop);
        card.addEventListener("focusout", stop);
      });
  }

  initMachineFilters();
  initHoverPreviews();
</script>
