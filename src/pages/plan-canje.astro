---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout title="Plan Canje — DYFMA">
  <section class="canje-hero">
    <div class="u-container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="eyebrow" data-sy-reveal="fade">
            <span class="eyebrow-line"></span>
            <span>PLAN CANJE</span>
          </div>

          <h1 class="page-title" data-sy-reveal="words">
            Renová tu maquina sin empezar de cero
          </h1>

          <p class="page-desc" data-sy-reveal="fade">
            Presentamos el Plan Canje DYFMA: entregas tu maquina usada, abonas
            la diferencia y te llevas una maquina nueva, con la tecnologia y el
            respaldo que necesitas para seguir haciendo crecer tu produccion.
          </p>

          <div class="hero-actions" data-sy-reveal="fade">
            <a
              href="https://wa.me/5493534118602?text=Hola!%20Quiero%20consultar%20por%20el%20Plan%20Canje%20DYFMA."
              target="_blank"
              rel="noopener"
              class="btn btn-wsp"
            >
              <svg class="wsp-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              <span>Escribinos por WhatsApp</span>
            </a>

            <Button title="Ir a contacto" url="/dyfmaweb/contacto" />
          </div>
        </div>

        <div class="hero-media" data-sy-reveal="fade">
          <img
            src="/dyfmaweb/plancanje.jpeg"
            alt="Plan Canje DYFMA — entregá tu máquina usada y renová por una nueva"
            width="800"
            height="600"
            loading="eager"
            decoding="async"
          />
          <div class="media-accent"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="how">
    <div class="u-container">
      <div class="eyebrow" data-sy-reveal="fade">
        <span class="eyebrow-line"></span>
        <span>COMO FUNCIONA</span>
      </div>

      <h2 class="section-title" data-sy-reveal="words">
        Cuatro pasos y estas renovando
      </h2>

      <ol class="steps">
        <li class="step" data-sy-reveal="fade">
          <span class="step-num">01</span>
          <div>
            <h3 class="step-title">Contactanos</h3>
            <p class="step-text">
              Escribinos por WhatsApp o desde el formulario y contanos que
              maquina tenes hoy y en que estado se encuentra.
            </p>
          </div>
        </li>

        <li class="step" data-sy-reveal="fade">
          <span class="step-num">02</span>
          <div>
            <h3 class="step-title">Evaluamos tu maquina</h3>
            <p class="step-text">
              Evaluamos y cotizamos tu equipo usado, sujeto a revision
              tecnica. Sin compromiso: si no te convence, no avanzas.
            </p>
          </div>
        </li>

        <li class="step" data-sy-reveal="fade">
          <span class="step-num">03</span>
          <div>
            <h3 class="step-title">Abonas la diferencia</h3>
            <p class="step-text">
              El valor de tu maquina usada se descuenta del equipo nuevo.
              Pagas solo la diferencia, con una inversion mucho mas accesible.
            </p>
          </div>
        </li>

        <li class="step" data-sy-reveal="fade">
          <span class="step-num">04</span>
          <div>
            <h3 class="step-title">Te llevas tu DYFMA nueva</h3>
            <p class="step-text">
              Recibis una maquina de fabricacion nacional, con garantia,
              repuestos y soporte directo de quien la construyo.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="benefits">
    <div class="u-container">
      <div class="eyebrow" data-sy-reveal="fade">
        <span class="eyebrow-line"></span>
        <span>BENEFICIOS</span>
      </div>

      <h2 class="section-title" data-sy-reveal="words">
        Por que canjear con DYFMA
      </h2>

      <ul class="benefits-list">
        <li class="benefit" data-sy-reveal="fade">
          <span class="check">✓</span>
          <div>
            <h3 class="benefit-title">Renova tu equipamiento</h3>
            <p class="benefit-text">
              Deja atras el desgaste y las mermas de una maquina vieja.
              Pasate a un equipo eficiente sin esperar a acumular todo el
              capital de una compra desde cero.
            </p>
          </div>
        </li>

        <li class="benefit" data-sy-reveal="fade">
          <span class="check">✓</span>
          <div>
            <h3 class="benefit-title">Mejora tu productividad</h3>
            <p class="benefit-text">
              Tecnologia mas reciente significa mas rendimiento por hora de
              trabajo, menos perdidas de tiempo y un proceso mas estable en
              cada cosecha.
            </p>
          </div>
        </li>

        <li class="benefit" data-sy-reveal="fade">
          <span class="check">✓</span>
          <div>
            <h3 class="benefit-title">Inverti de manera mas accesible</h3>
            <p class="benefit-text">
              Tu maquina usada vale: se convierte en parte del pago. Una forma
              mas accesible de renovar sin descapitalizar tu produccion.
            </p>
          </div>
        </li>

        <li class="benefit" data-sy-reveal="fade">
          <span class="check">✓</span>
          <div>
            <h3 class="benefit-title">Respaldo de fabrica</h3>
            <p class="benefit-text">
              Compras directo al fabricante. Garantia, repuestos y soporte
              tecnico desde Villa Maria, Cordoba, sin intermediarios.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="canje-cta">
    <div class="u-container">
      <div class="cta-inner">
        <div class="eyebrow cta-eyebrow" data-sy-reveal="fade">
          <span class="eyebrow-line"></span>
          <span>SIN COMPROMISO</span>
        </div>

        <h2 class="cta-title" data-sy-reveal="words">
          Evaluamos tu maquina sin compromiso
        </h2>

        <p class="cta-text" data-sy-reveal="fade">
          Escribinos por WhatsApp, contanos que maquina tenes y te respondemos
          con la cotizacion de tu canje. Empezar a renovar tu produccion es
          mas simple de lo que pensas.
        </p>

        <div class="cta-actions" data-sy-reveal="fade">
          <a
            href="https://wa.me/5493534118602?text=Hola!%20Quiero%20consultar%20por%20el%20Plan%20Canje%20DYFMA."
            target="_blank"
            rel="noopener"
            class="btn btn-wsp"
          >
            <svg class="wsp-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span>WhatsApp</span>
          </a>

          <Button title="Contacto" url="/dyfmaweb/contacto" class="btn-contact" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .canje-hero {
    padding: 8rem 0 5rem;
  }

  .hero-grid {
    display: grid;

    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);

    align-items: center;

    gap: 4rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;

    gap: 0.75rem;

    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;

    letter-spacing: 0.12em;
    text-transform: uppercase;

    color: var(--color-brand-1);
  }

  .eyebrow-line {
    width: 2rem;
    height: 1px;

    background: var(--color-brand-1);

    flex-shrink: 0;
  }

  .page-title {
    --fs: var(--type-display);

    margin: 1.25rem 0 0;

    max-width: 12em;

    font-family: var(--font-heading);

    font-size: var(--fs);
    font-weight: 500;
    line-height: 0.98;

    letter-spacing: -0.01em;

    color: var(--color-brand-1);
  }

  .page-desc {
    margin: 1.5rem 0 0;

    max-width: 32em;

    font-size: var(--font-size-lg);
    line-height: 1.6;

    color: var(--color-text-alt);
  }

  .hero-actions {
    display: flex;

    gap: 1rem;

    margin-top: 2rem;

    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;

    align-items: center;

    gap: 0.5rem;

    padding: 0.85rem 1.75rem;

    background: var(--color-brand-1);
    color: #fff;

    text-decoration: none;

    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--font-size-md);

    transition: background 0.2s ease, color 0.2s ease;
  }

  .btn:hover {
    background: var(--color-white);
    color: var(--color-brand-1);
  }

  .wsp-icon {
    width: 1.15em;
    height: 1.15em;

    flex-shrink: 0;
  }

  .hero-media {
    position: relative;

    height: 100%;

    min-height: 24rem;
  }

  .hero-media img {
    display: block;

    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center top;

    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.07));
  }

  .media-accent {
    position: absolute;

    right: 0;
    bottom: 0;

    width: 4.5rem;
    height: 4.5rem;

    border-right: 3px solid var(--color-brand-1);
    border-bottom: 3px solid var(--color-brand-1);

    pointer-events: none;
  }

  /* =========================================================
     HOW IT WORKS
     ========================================================= */

  .how {
    padding: 4rem 0;
  }

  .section-title {
    --fs: var(--type-display);

    margin: 1.25rem 0 0;

    max-width: 12em;

    font-family: var(--font-heading);

    font-size: var(--fs);
    font-weight: 500;
    line-height: 0.98;

    letter-spacing: -0.01em;

    color: var(--color-brand-1);
  }

  .steps {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 2.5rem 4rem;

    margin: 3rem 0 0;

    padding: 0;

    list-style: none;
  }

  .step {
    display: flex;

    gap: 1.5rem;

    padding-bottom: 2rem;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;

    color: var(--color-brand-1);

    flex-shrink: 0;
  }

  .step-title {
    margin: 0;

    font-family: var(--font-heading);
    font-size: var(--type-title);
    font-weight: 500;
    line-height: 1.1;

    letter-spacing: -0.01em;

    color: var(--color-brand-1);
  }

  .step-text {
    margin: 0.5rem 0 0;

    font-size: var(--font-size-md);
    line-height: 1.55;

    color: var(--color-text-alt);
  }

  /* =========================================================
     BENEFITS
     ========================================================= */

  .benefits {
    padding: 4rem 0;
  }

  .benefits-list {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 2.5rem 4rem;

    margin: 3rem 0 0;

    padding: 0;

    list-style: none;
  }

  .benefit {
    display: flex;

    gap: 1.25rem;
  }

  .check {
    display: grid;
    place-items: center;

    width: 2rem;
    height: 2rem;

    border: 1px solid var(--color-brand-1);

    color: var(--color-brand-1);

    font-size: 0.85rem;
    font-weight: 700;

    flex-shrink: 0;
  }

  .benefit-title {
    margin: 0;

    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.15;

    color: var(--color-brand-1);
  }

  .benefit-text {
    margin: 0.5rem 0 0;

    font-size: var(--font-size-md);
    line-height: 1.55;

    color: var(--color-text-alt);
  }

  /* =========================================================
     CTA
     ========================================================= */

  .canje-cta {
    padding: 4rem 0 6rem;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;

    align-items: center;

    text-align: center;

    padding: clamp(3rem, 6vw, 5rem) 2rem;

    border: 1px solid rgba(242, 140, 40, 0.22);
  }

  .cta-title {
    --fs: var(--type-display);

    margin: 1.25rem 0 0;

    max-width: 12em;

    font-family: var(--font-heading);

    font-size: var(--fs);
    font-weight: 500;
    line-height: 0.98;

    letter-spacing: -0.01em;

    color: var(--color-brand-1);
  }

  .cta-text {
    margin: 1.5rem 0 0;

    max-width: 34em;

    font-size: var(--font-size-lg);
    line-height: 1.6;

    color: var(--color-text-alt);
  }

  .cta-actions {
    display: flex;

    gap: 1rem;

    margin-top: 2rem;

    flex-wrap: wrap;

    justify-content: center;
  }

  .cta-actions :global(.btn-contact) {
    background: transparent;
    color: var(--color-brand-1);
  }

  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (--mq-desktop-md) {
    .hero-grid {
      gap: 3rem;
    }
  }

  @media (--mq-tablet) {
    .canje-hero {
      padding: 6rem 0 3rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;

      gap: 3rem;
    }

    .hero-media {
      width: min(100%, 32rem);

      margin: 0 auto;
    }

    .steps,
    .benefits-list {
      grid-template-columns: 1fr;

      gap: 0;
    }

    .benefit {
      padding-bottom: 2rem;

      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  @media (--mq-phone) {
    .canje-hero {
      padding: 5rem 0 2rem;
    }

    .page-title {
      --fs: var(--type-title);

      line-height: 1.02;
    }

    .section-title {
      --fs: var(--type-title);
    }

    .cta-title {
      --fs: var(--type-title);
    }

    .hero-actions,
    .cta-actions {
      flex-direction: column;

      width: 100%;
    }

    .hero-actions :global(.btn),
    .hero-actions .btn,
    .cta-actions .btn {
      justify-content: center;
      width: 100%;
    }
  }
</style>
